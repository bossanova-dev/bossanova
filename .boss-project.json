{
  "version": 1,
  "project": "bossanova",
  "repo": {
    "originUrl": "https://github.com/recurser/bossanova",
    "displayName": "bossanova",
    "setupScript": "make setup-worktree",
    "settings": {
      "canAutoMerge": false,
      "canAutoMergeDependabot": true,
      "mergeStrategy": "rebase",
      "canAutoRepair": true,
      "shouldArchiveSessionsAfterMerge": true,
      "canAutoDeleteBranches": true,
      "shouldKeepBranchesCurrent": false
    },
    "secrets": {
      "linearApiKey": {
        "env": "BOSS_LINEAR_API_KEY"
      }
    }
  },
  "daemons": [
    {
      "name": "delta",
      "daemonId": "46f355de95e5cde2",
      "path": "~/Documents/Code/bossanova"
    },
    {
      "name": "kamikai",
      "daemonId": "4e28b20cd7fee13a",
      "path": "~/Documents/Code/bossanova"
    }
  ],
  "crons": [
    {
      "name": "bs-build",
      "agent": "codex",
      "prompt": "/boss-build headless --max-open-prs 8",
      "schedule": "*/30 * * * *",
      "concurrencyPolicy": "allow-concurrent",
      "gateCommand": "node skills-toolbox/cron-gates/boss-build.mjs --max-open-prs 8",
      "daemons": ["delta"]
    },
    {
      "name": "bs-debt",
      "agent": "codex",
      "prompt": "/bs-sweep-debt burn-down",
      "schedule": "10 2 * * *",
      "daemons": ["delta"]
    },
    {
      "name": "bs-dependabot",
      "agent": "claude",
      "prompt": "/bs-sweep-dependabot",
      "schedule": "@daily",
      "gateCommand": "node .claude/skills/bs-sweep-dependabot/gate/gate.mjs",
      "daemons": ["delta"]
    },
    {
      "name": "bs-plan",
      "agent": "claude",
      "prompt": "/boss-plan",
      "schedule": "*/15 * * * *",
      "timezone": "America/Toronto",
      "concurrencyPolicy": "allow-concurrent",
      "zeroOutput": true,
      "daemons": ["delta"]
    },
    {
      "name": "bs-prettify",
      "agent": "codex",
      "prompt": "/bs-sweep-prettify",
      "schedule": "10 4 * * *",
      "gateCommand": "node .claude/skills/bs-sweep-prettify/gate/gate.mjs",
      "daemons": ["delta"]
    },
    {
      "name": "bs-releases",
      "agent": "claude",
      "prompt": "/bs-sweep-releases",
      "schedule": "0 9 * * 6",
      "timezone": "America/Toronto",
      "gateCommand": "node .claude/skills/bs-sweep-releases/gate/gate.mjs",
      "zeroOutput": true,
      "daemons": ["delta"]
    },
    {
      "name": "bs-retro",
      "agent": "claude",
      "prompt": "/boss-retro",
      "schedule": "0 9 * * 0",
      "timezone": "America/Toronto",
      "gateCommand": "node skills-toolbox/cron-gates/boss-retro.mjs",
      "daemons": ["delta"]
    },
    {
      "name": "bs-sentry",
      "agent": "codex",
      "prompt": "/bs-sweep-sentry --no-dry-run",
      "schedule": "10 6 * * *",
      "gateCommand": "node .claude/skills/bs-sweep-sentry/gate/gate.mjs",
      "zeroOutput": true,
      "daemons": ["delta"]
    },
    {
      "name": "bs-tidy-linear",
      "agent": "codex",
      "prompt": "/bs-sweep-tidy-linear",
      "schedule": "@hourly",
      "gateCommand": "node .claude/skills/bs-sweep-tidy-linear/gate/gate.mjs",
      "zeroOutput": true,
      "daemons": ["delta"]
    },
    {
      "name": "bs-update",
      "agent": "codex",
      "prompt": "/bs-sweep-update",
      "schedule": "55 * * * *",
      "timezone": "Asia/Tokyo",
      "gateCommand": "node .claude/skills/bs-sweep-update/gate/gate.mjs",
      "runSetupCommand": false,
      "zeroOutput": true,
      "daemons": ["delta"]
    },
    {
      "name": "bs-verify",
      "factoryStage": "verify",
      "agent": "claude",
      "enabled": true,
      "daemons": ["delta"]
    },
    {
      "name": "bs-verify-kamikai",
      "agent": "claude",
      "prompt": "/boss-verify",
      "schedule": "*/10 * * * *",
      "gateCommand": "node skills-toolbox/cron-gates/boss-verify-local-sessions.mjs",
      "daemons": ["kamikai"]
    },
    {
      "name": "bs-security",
      "agent": "claude",
      "prompt": "/bs-security --no-dry-run",
      "schedule": "0 22 * * 0",
      "timezone": "America/Toronto",
      "zeroOutput": true,
      "daemons": ["delta"]
    },
    {
      "name": "bs-architecture",
      "agent": "claude",
      "prompt": "/bs-architecture",
      "schedule": "0 9 1 * *",
      "timezone": "America/Toronto",
      "zeroOutput": true,
      "daemons": ["delta"]
    }
  ]
}
