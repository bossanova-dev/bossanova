{
  "commands": {
    "test": "make test-full",
    "testAffected": "make test-affected",
    "testReadiness": "BOSS_GATE_FORCE_UNCACHED=1 make test-full",
    "testUncached": "BOSS_GATE_FORCE_UNCACHED=1 make test-affected"
  },
  "gateCache": {
    "eligible": {
      "test-full": {
        "cacheable": true,
        "reason": "iterative full decisions only: deterministic over tracked repo content and served from Bazel/Go caches"
      },
      "test-bossalib": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-boss": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-bossd": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-bosso": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-mcp": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-mcp-gateway": {
        "cacheable": true,
        "reason": "optional module target delegates to Bazel/native Go over tracked repo content"
      }
    },
    "ineligible": {
      "test-smoke": "checks installed skill mirrors and toolboxes outside the hashed corpus",
      "test-affected": "a selection-dependent narrow run cannot satisfy the readiness full-gate receipt",
      "test-race": "race-detector verdicts can differ between runs over identical content",
      "test-web-e2e": "browser and network state are outside the hashed corpus",
      "build-drift-check": "reads generated-artifact and checkout state beyond a declared test gate",
      "post-rebase-check": "must run after a rebase even when content appears unchanged"
    }
  },
  "test": {
    "manifestPath": "docs/testing/test-command-manifest.md"
  },
  "trackerConfig": {
    "linear": {
      "mcpServer": "bossanova-linear",
      "workspace": "bossanova-dev",
      "team": "Bossanova",
      "teamKey": "BOS",
      "states": {
        "backlog": "Backlog",
        "unplanned": "Unplanned",
        "done": "Done",
        "canceled": "Canceled",
        "duplicate": "Duplicate"
      },
      "labels": {
        "bug": "bug"
      },
      "followUpLabels": ["follow-up", "agent-plan"]
    }
  },
  "publishConfig": {
    "proof": {
      "bucket": "bossanova-proof-production",
      "baseUrl": "https://proof.bossanova.dev"
    }
  },
  "planDependencies": {
    "moduleRoots": [
      "docs",
      "infra",
      "lib",
      "mk",
      "plans",
      "plugins",
      "proto",
      "scripts",
      "services",
      "skills-toolbox"
    ],
    "repoWideTokens": ["docs/skills/README.md"],
    "areaAliases": {}
  },
  "retro": {
    "pathAliases": {
      ".claude/skills/": "services/boss/internal/skillinstall/skills/"
    }
  },
  "verifyDefaults": {
    "humanReview": {
      "ui": [
        "services/boss/internal/views/**",
        "services/web/index.html",
        "services/web/src/*",
        "services/web/src/analytics/**",
        "services/web/src/billing/**",
        "services/web/src/components/**",
        "services/web/src/hooks/**",
        "services/web/src/lib/**",
        "services/web/src/machines/**",
        "services/web/src/pages/**"
      ],
      "database": ["services/bossd/migrations/**", "services/bosso/migrations_postgres/**"],
      "security": [
        ".boss-project.json",
        {
          "glob": ".boss-skills.json",
          "label": "verify gate rules (how PRs get merged)"
        },
        ".claude/settings.json",
        {
          "glob": ".claude/skills/boss-verify-*/**",
          "label": "verify gate rules (how PRs get merged)"
        },
        {
          "glob": ".codex/skills/boss-verify-*/**",
          "label": "verify gate rules (how PRs get merged)"
        },
        {
          "glob": ".github/workflows/**",
          "label": "CI workflows"
        },
        "lib/bossalib/authlock/**",
        "lib/bossalib/authtoken/**",
        "lib/bossalib/gatecmd/**",
        "lib/bossalib/keyringutil/**",
        "lib/bossalib/socketauth/**",
        "scripts/verify-security-surface.mjs",
        "services/boss/internal/auth/**",
        "services/bossd/internal/proofenv/**",
        "services/bossd/internal/proofenvkeyring/**",
        "services/bossd/internal/upstream/trigger_gate.go",
        "services/bosso/internal/auth/**",
        "services/bosso/internal/githubapp/**",
        "services/bosso/internal/server/attach_token.go",
        "services/bosso/internal/server/session_webhook_deliveries.go",
        "services/bosso/internal/server/session_webhooks.go",
        "services/bosso/internal/server/trigger_http.go",
        "services/bosso/internal/server/triggers.go",
        "services/bosso/internal/sessionwebhook/**",
        "services/bosso/internal/trigger/**",
        "services/bosso/internal/triggeringest/**",
        "services/bosso/internal/triggerlaunch/**",
        "services/bosso/internal/webhook/**",
        "services/mcp-gateway/internal/auth/**"
      ]
    },
    "alwaysHumanPaths": [
      ".boss-project.json",
      {
        "glob": ".boss-skills.json",
        "label": "verify gate rules (how PRs get merged)"
      },
      ".claude/settings.json",
      {
        "glob": ".claude/skills/boss-verify-*/**",
        "label": "verify gate rules (how PRs get merged)"
      },
      {
        "glob": ".codex/skills/boss-verify-*/**",
        "label": "verify gate rules (how PRs get merged)"
      },
      {
        "glob": ".github/workflows/**",
        "label": "CI workflows"
      },
      "lib/bossalib/authlock/**",
      "lib/bossalib/authtoken/**",
      "lib/bossalib/gatecmd/**",
      "lib/bossalib/keyringutil/**",
      "lib/bossalib/socketauth/**",
      "scripts/verify-security-surface.mjs",
      "services/boss/internal/auth/**",
      "services/boss/internal/views/**",
      "services/bossd/internal/proofenv/**",
      "services/bossd/internal/proofenvkeyring/**",
      "services/bossd/internal/upstream/trigger_gate.go",
      "services/bossd/migrations/**",
      "services/bosso/internal/auth/**",
      "services/bosso/internal/githubapp/**",
      "services/bosso/internal/server/attach_token.go",
      "services/bosso/internal/server/session_webhook_deliveries.go",
      "services/bosso/internal/server/session_webhooks.go",
      "services/bosso/internal/server/trigger_http.go",
      "services/bosso/internal/server/triggers.go",
      "services/bosso/internal/sessionwebhook/**",
      "services/bosso/internal/trigger/**",
      "services/bosso/internal/triggeringest/**",
      "services/bosso/internal/triggerlaunch/**",
      "services/bosso/internal/webhook/**",
      "services/bosso/migrations_postgres/**",
      "services/mcp-gateway/internal/auth/**",
      "services/web/index.html",
      "services/web/src/*",
      "services/web/src/analytics/**",
      "services/web/src/billing/**",
      "services/web/src/components/**",
      "services/web/src/hooks/**",
      "services/web/src/lib/**",
      "services/web/src/machines/**",
      "services/web/src/pages/**"
    ],
    "evidence": true
  }
}
