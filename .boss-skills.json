{
  "commands": {
    "build": "make build",
    "lint": "make lint",
    "format": "make format",
    "test": "make test-full",
    "testAffected": "make test-affected",
    "testReadiness": "BOSS_GATE_FORCE_UNCACHED=1 make test-full",
    "testUncached": "BOSS_GATE_FORCE_UNCACHED=1 make test-affected"
  },
  "gateCache": {
    "eligible": {
      "test-full": {
        "cacheable": true,
        "reason": "iterative full decisions only: deterministic over tracked repo content and served from Bazel/Go caches"
      },
      "test-bossalib": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-boss": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-bossd": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-bosso": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-mcp": {
        "cacheable": true,
        "reason": "module target delegates to Bazel/native Go over tracked repo content"
      },
      "test-mcp-gateway": {
        "cacheable": true,
        "reason": "optional module target delegates to Bazel/native Go over tracked repo content"
      }
    },
    "ineligible": {
      "test-smoke": "checks installed skill mirrors and toolboxes outside the hashed corpus",
      "test-affected": "a selection-dependent narrow run cannot satisfy the readiness full-gate receipt",
      "test-race": "race-detector verdicts can differ between runs over identical content",
      "test-web-e2e": "browser and network state are outside the hashed corpus",
      "build-drift-check": "reads generated-artifact and checkout state beyond a declared test gate",
      "post-rebase-check": "must run after a rebase even when content appears unchanged"
    }
  },
  "test": {
    "manifestPath": "docs/testing/test-command-manifest.md"
  },
  "trackerConfig": {
    "linear": {
      "mcpServer": "bossanova-linear",
      "workspace": "bossanova-dev",
      "team": "Bossanova",
      "teamKey": "BOS",
      "states": {
        "backlog": "Backlog",
        "unplanned": "Unplanned",
        "done": "Done",
        "canceled": "Canceled",
        "duplicate": "Duplicate"
      },
      "labels": {
        "bug": "bug"
      },
      "followUpLabels": ["follow-up", "agent-plan"]
    }
  },
  "publishConfig": {
    "proof": {
      "bucket": "bossanova-proof-production",
      "baseUrl": "https://proof.bossanova.dev"
    }
  },
  "planDependencies": {
    "moduleRoots": [
      "docs",
      "infra",
      "lib",
      "mk",
      "plans",
      "plugins",
      "proto",
      "scripts",
      "services",
      "skills-toolbox"
    ],
    "repoWideTokens": ["docs/skills/README.md"],
    "areaAliases": {}
  },
  "retro": {
    "upstream": { "self": true },
    "pathAliases": {
      ".claude/skills/": "lib/bossalib/contract/plugin/skillpayload/skills/"
    }
  },
  "verifyDefaults": {
    "humanReview": {
      "ui": [
        "services/boss/api/tui/**",
        "services/web/index.html",
        "services/web/src/**/*.tsx",
        "services/web/src/**/*.css",
        "lib/ui-tokens/*.css",
        "services/web/public/*.png",
        "services/web/public/*.svg",
        "services/marketing/src/components/**/*.astro",
        "services/marketing/src/layouts/**",
        "services/marketing/src/pages/**/*.astro",
        "services/marketing/src/styles/**",
        "services/marketing/src/content/**",
        "services/marketing/public/*/**",
        "services/marketing/public/*.png",
        "services/docs/docs/**",
        "services/docs/src/**/*.tsx",
        "services/docs/src/**/*.css",
        "services/docs/static/img/**",
        "services/docs/sidebars.ts",
        "services/docs/docusaurus.config.ts"
      ],
      "database": [
        {
          "glob": "services/bossd/migrations/**",
          "label": "bossd database migration"
        },
        {
          "glob": "services/bosso/migrations_postgres/**",
          "label": "bosso Postgres migration"
        }
      ],
      "security": [
        {
          "glob": "services/bosso/api/auth/**",
          "label": "bosso authentication"
        },
        {
          "glob": "services/bosso/internal/auth/**",
          "label": "bosso authentication"
        },
        {
          "glob": "services/bosso/internal/billing/**",
          "label": "billing and cloud access"
        },
        {
          "glob": "services/bosso/internal/domain/policy/**",
          "label": "bosso authorization"
        },
        {
          "glob": "services/bosso/internal/domain/permission/**",
          "label": "bosso authorization"
        },
        {
          "glob": "services/bosso/internal/daemonproxy/session_org_authz.go",
          "label": "bosso authorization"
        },
        {
          "glob": "services/bosso/api/orchestrator/entitlement_interceptor.go",
          "label": "entitlement and permission checks"
        },
        {
          "glob": "services/bosso/api/orchestrator/authz_interceptor.go",
          "label": "entitlement and permission checks"
        },
        {
          "glob": "services/bosso/api/orchestrator/permissions.go",
          "label": "entitlement and permission checks"
        },
        {
          "glob": "services/bosso/api/orchestrator/agentaccounts/credentials.go",
          "label": "bosso credentials and device keys"
        },
        {
          "glob": "services/bosso/api/orchestrator/agentaccounts/devices.go",
          "label": "bosso credentials and device keys"
        },
        {
          "glob": "services/bosso/internal/domain/agent_credential*.go",
          "label": "bosso credentials and device keys"
        },
        {
          "glob": "services/bosso/internal/domain/api_token.go",
          "label": "bosso credentials and device keys"
        },
        {
          "glob": "services/bosso/internal/domain/daemon_identity_key.go",
          "label": "bosso credentials and device keys"
        },
        {
          "glob": "services/bossd/internal/devicekey/**",
          "label": "bossd credentials and device keys"
        },
        {
          "glob": "services/bossd/api/upstream/credential_*.go",
          "label": "bossd credentials and device keys"
        },
        {
          "glob": "services/bossd/api/upstream/device_key.go",
          "label": "bossd credentials and device keys"
        },
        {
          "glob": "services/bossd/api/daemon/credential_devices.go",
          "label": "bossd credentials and device keys"
        },
        {
          "glob": "services/bossd/cmd/credential_*.go",
          "label": "bossd credentials and device keys"
        },
        {
          "glob": "services/bossd/internal/adapter/reposecrets/**",
          "label": "bossd credentials and device keys"
        },
        {
          "glob": "services/bossd/internal/adapter/proofenvkeyring/**",
          "label": "bossd credentials and device keys"
        },
        {
          "glob": "lib/bossalib/contract/daemon/keyringutil/**",
          "label": "daemon credential primitives"
        },
        {
          "glob": "lib/bossalib/contract/daemon/authtoken/**",
          "label": "daemon credential primitives"
        },
        {
          "glob": "lib/bossalib/contract/daemon/socketauth/**",
          "label": "daemon credential primitives"
        },
        {
          "glob": "services/mcp-gateway/internal/auth/**",
          "label": "gateway authentication and permissions"
        },
        {
          "glob": "services/mcp-gateway/api/gateway/middleware.go",
          "label": "gateway authentication and permissions"
        },
        {
          "glob": "services/mcp-gateway/api/gateway/permissions.go",
          "label": "gateway authentication and permissions"
        },
        {
          "glob": "proto/**",
          "label": "API contract (proto)"
        }
      ]
    },
    "alwaysHumanPaths": [
      {
        "glob": "infra/**",
        "label": "infrastructure"
      },
      {
        "glob": ".github/workflows/**",
        "label": "CI workflows"
      },
      {
        "glob": "skills-toolbox/verify/**",
        "label": "the verify judge (cannot grade itself)"
      },
      {
        "glob": "lib/bossalib/contract/plugin/skillpayload/skills/*/toolbox/verify/**",
        "label": "the verify judge (cannot grade itself)"
      }
    ],
    "generatedPaths": [
      "lib/bossalib/gen/**/*.pb.go",
      "lib/bossalib/gen/**/*.connect.go",
      "services/web/src/gen/**/*_pb.ts",
      "services/docs/openapi/bossanova.v1.openapi.yaml"
    ],
    "generatedChecks": ["drift"],
    "evidence": true
  },
  "planContract": {
    "sections": [
      {
        "heading": "## Summary",
        "required": "always"
      },
      {
        "heading": "## Approach",
        "required": "optional"
      },
      {
        "heading": "## Key changes",
        "required": "optional"
      },
      {
        "heading": "## Testing",
        "required": "optional"
      },
      {
        "heading": "## Risks / unknowns",
        "required": "optional"
      },
      {
        "heading": "## Premises",
        "required": "optional"
      },
      {
        "heading": "## Acceptance criteria",
        "required": "optional"
      },
      {
        "heading": "## Required proof",
        "required": "optional"
      },
      {
        "heading": "## Proof harness analysis",
        "required": "optional"
      },
      {
        "heading": "## Feature map changes",
        "required": "optional"
      },
      {
        "heading": "## Why this needs a human",
        "required": "needs-human"
      },
      {
        "heading": "## Open Questions",
        "required": "open-questions"
      },
      {
        "heading": "## Planning",
        "required": "optional"
      },
      {
        "heading": "## Original notes",
        "required": "always"
      }
    ]
  }
}
