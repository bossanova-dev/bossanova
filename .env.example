# Public / self-host environment example for Bossanova.
#
# Only client-side TUI/daemon settings are relevant to this repository. The
# hosted backend (bosso), web UI, marketing site, and infrastructure config
# live in the private repo and are intentionally excluded from this mirror,
# along with their environment variables.
#
# The public mirror replaces the private .env.example with this file at
# release time (see .github/workflows/mirror-public.yml). Keep it free of any
# secrets and of internal infrastructure variable names.

# macOS code-signing identity used by `make` when building signed binaries.
# Self-hosters: set to your own Developer ID, or leave unset for unsigned builds.
CODESIGN_IDENTITY=

# ─── TUI / daemon client-side overrides (optional) ─────────────────
# Unset → production defaults baked into the binaries. Override for
# staging/self-host. BOSSD_ORCHESTRATOR_URL="" forces local-only mode.

BOSS_WORKOS_CLIENT_ID=   # defaults to the production WorkOS client baked into the binary
BOSS_REPORT_URL=         # defaults to https://orchestrator.bossanova.dev
BOSSD_ORCHESTRATOR_URL=  # defaults to https://orchestrator.bossanova.dev; empty = local-only

# Local-dev escape hatch on macOS: setting this to "file" routes auth tokens
# to the encrypted file backend at ~/.config/bossanova/keyring/ instead of the
# system Keychain, so iterating with `go run` doesn't trigger a Keychain
# password prompt on every rebuild. Leave unset in production.
BOSS_KEYRING_BACKEND=file
