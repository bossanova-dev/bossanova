
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Generated by `make generate` from proto/. Both sides changing one of these (a one-line base64
# descriptor in *_pb.ts) is not a real conflict: the `generated` merge driver keeps the current
# side, and the generators then run again over the merged protos. CI's proto drift check fails a
# head that skipped regeneration. Define the driver once per clone with `make merge-drivers`.
# Keep this list equal to verifyDefaults.generatedPaths in .boss-skills.json.
lib/bossalib/gen/**/*.pb.go merge=generated linguist-generated=true
lib/bossalib/gen/**/*.connect.go merge=generated linguist-generated=true
services/web/src/gen/**/*_pb.ts merge=generated linguist-generated=true
services/docs/openapi/bossanova.v1.openapi.yaml merge=generated linguist-generated=true
