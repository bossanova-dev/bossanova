# Go
bin/
.generate.stamp
*.exe
*.test
*.out

# Node (prettier only)
node_modules/
.node-version

# Protobuf generated code (committed for CI — regenerate with `make generate`)
# lib/bossalib/gen/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Env
.env
.env.local

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# Build artifacts (binaries outside bin/)
/services/bossd/main
# Root-anchored so it never matches the plugins/bossd-plugin-*/ source dirs.
/bossd-plugin-*
# Plugin-local binaries produced by running go build inside a plugin dir.
/plugins/bossd-plugin-*/bossd-plugin-*

# Misc
*.log
.boss/
.worktrees/
docs/handoffs/

# Mutation testing reports
.mutate/

# Proof-of-implementation screenshot bundles (uploaded to a public bucket, never committed)
.proof/

# Wrangler v4 local state dir, created by `wrangler r2 object put` during proof uploads
.wrangler/

# Linear plan scratch dir (bs-linear-plan skill; plans are uploaded to R2, not committed)
.linear-plans/

# Beads
.beads/interactions.jsonl
.beads/issues.jsonl
.gstack/

# Compound Engineering machine-local config
.compound-engineering/*.local.yaml

# Local Bossanova development profile
/.config/
/config/

# Kubernetes secrets
infra/kustomize/overlays/*/.env-bosso
