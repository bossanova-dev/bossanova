load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:exclude openapiversion_test.go
# gazelle:exclude webversion_test.go

go_library(
    name = "apiversion",
    srcs = [
        "interceptor.go",
        "procedureset.go",
        "released.go",
        "transform.go",
        "version.go",
    ],
    importpath = "github.com/recurser/bossalib/apiversion",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/bossalib/displaystatus",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/gen/bossanova/v1/bossanovav1connect",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)

go_test(
    name = "apiversion_test",
    srcs = [
        "changelogversion_test.go",
        "interceptor_test.go",
        "procedureset_test.go",
        "production_coverage_test.go",
        "proxy_list_repos_holder_resolution_test.go",
        "proxy_list_sessions_owner_resolution_test.go",
        "released_test.go",
        "superseded_credential_class_test.go",
        "transform_test.go",
        "version_test.go",
    ],
    embed = [":apiversion"],
    # keep: webversion_test.go reads services/web/src/api.ts and
    # openapiversion_test.go reads services/docs/openapi/*.yaml; both escape the
    # bossalib module and are absent from the Bazel sandbox. Excluded from `bazel test`;
    # still covered by `make test`. See docs/solutions/build-systems/bazel-sandbox-patterns.md.
    tags = ["manual"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/gen/bossanova/v1/bossanovav1connect",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//reflect/protodesc",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//types/descriptorpb",
    ],
)
