load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "attention",
    srcs = [
        "alertkeys.go",
        "attention.go",
        "rotation.go",
        "templates.go",
    ],
    importpath = "github.com/recurser/bossalib/attention",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "attention_test",
    srcs = [
        "alertkeys_test.go",
        "attention_test.go",
        "park_code_words_test.go",
        "park_kind_test.go",
        "partial_marker_test.go",
        "verified_not_merged_test.go",
        "verify_hold_test.go",
        "waiting_words_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":attention"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "@org_golang_google_protobuf//proto",
    ],
)
