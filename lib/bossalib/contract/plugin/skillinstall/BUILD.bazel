load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "skillinstall",
    srcs = [
        "consent.go",
        "doc.go",
        "extract.go",
        "heal.go",
        "preserve.go",
        "record.go",
        "swap.go",
        "swap_darwin.go",
        "swap_linux.go",
        "swap_other.go",
    ],
    importpath = "github.com/recurser/bossalib/contract/plugin/skillinstall",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_gofrs_flock//:flock",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
