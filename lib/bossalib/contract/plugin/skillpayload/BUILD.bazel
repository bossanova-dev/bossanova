load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "skillpayload",
    srcs = ["embed.go"],
    # A glob mirrors `//go:embed all:skills`, so adding or removing a payload file needs no
    # BUILD edit; gazelle's explicit list appended every new file at its end and conflicted.
    embedsrcs = glob(["skills/**"]),  # keep
    importpath = "github.com/recurser/bossalib/contract/plugin/skillpayload",
    visibility = ["//visibility:public"],
)

go_test(
    name = "skillpayload_test",
    srcs = ["skills_manifest_test.go"],
    embed = [":skillpayload"],
)
