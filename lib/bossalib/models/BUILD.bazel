load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "models",
    srcs = [
        "broadcast.go",
        "convert.go",
        "cron_job.go",
        "github_callback.go",
        "models.go",
        "note.go",
    ],
    importpath = "github.com/recurser/bossalib/models",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/machine",
