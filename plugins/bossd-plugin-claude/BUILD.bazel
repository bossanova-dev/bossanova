load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# Package marker only — required so Gazelle's go_deps.from_file(go_work = "//:go.work")
# can resolve //plugins/bossd-plugin-claude:go.mod as a Bazel label. This module is not yet bazelified
# (its BUILD targets land in BOS-344); it intentionally contains zero targets.

go_library(
    name = "bossd-plugin-claude_lib",
    srcs = [
        "cap.go",
        "dirty_files.go",
        "hookconfig.go",
        "limit.go",
        "main.go",
        "mcpsurface.go",
        "plugin.go",
        "probe.go",
        "progress.go",
        "runner.go",
        "server.go",
        "transcript.go",
    ],
    importpath = "github.com/recurser/bossd-plugin-claude",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/bossalib/buildinfo",
        "//lib/bossalib/contract/plugin/agenterr",
        "//lib/bossalib/contract/plugin/agentruntime",
        "//lib/bossalib/contract/plugin/agentsession",
        "//lib/bossalib/contract/plugin/childenv",
        "//lib/bossalib/contract/plugin/loginshell",
        "//lib/bossalib/contract/plugin/plugin",
        "//lib/bossalib/contract/plugin/plugin/hostclient",
        "//lib/bossalib/contract/plugin/skillinstall",
        "//lib/bossalib/contract/plugin/skillpayload",
        "//lib/bossalib/contract/plugin/statusdetect",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "@com_github_hashicorp_go_plugin//:go-plugin",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_binary(
    name = "bossd-plugin-claude",
    embed = [":bossd-plugin-claude_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bossd-plugin-claude_test",
    srcs = [
        "cap_test.go",
        "conformance_test.go",
        "exitstatus_test.go",
        "hookconfig_test.go",
        "limit_test.go",
        "live_mcpsurface_test.go",
        "main_test.go",
        "mcpsurface_test.go",
        "probe_test.go",
        "progress_test.go",
        "rotation_test.go",
        "runner_test.go",
        "server_test.go",
        "suggest_pr_title_test.go",
        "transcript_test.go",
        "turn_ended_hook_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":bossd-plugin-claude_lib"],
    deps = [
        "//lib/bossalib/contract/plugin/agenterr",
        "//lib/bossalib/contract/plugin/agentruntime",
        "//lib/bossalib/contract/plugin/plugin",
        "//lib/bossalib/contract/plugin/plugin/agentrunnertest",
        "//lib/bossalib/contract/plugin/skillinstall",
        "//lib/bossalib/contract/plugin/skillpayload",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//status",
        "@org_golang_google_grpc//test/bufconn",
    ],
)

# Production sources consumed by the host environment-policy guard.
filegroup(
    name = "env_policy_sources",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//services/bossd/internal/plugin:__pkg__"],
)
