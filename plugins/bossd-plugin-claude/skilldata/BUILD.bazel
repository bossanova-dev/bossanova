# keep: raw skill tree exposed as a filegroup so the tree-aware skill-payload
# parity test (//services/boss/internal/skillparity, BOS-344 Task 5) can read
# this mirror from disk under bazel runfiles and compare it to the boss embed.
filegroup(
    name = "skills_payload",
    srcs = glob(["skills/**"]),
    visibility = ["//visibility:public"],
)
