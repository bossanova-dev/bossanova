load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# Package marker only — required so Gazelle's go_deps.from_file(go_work = "//:go.work")
# can resolve //plugins/bossd-plugin-linear:go.mod as a Bazel label. This module is not yet bazelified
# (its BUILD targets land in BOS-344); it intentionally contains zero targets.

go_library(
    name = "bossd-plugin-linear_lib",
    srcs = [
        "endpoint_e2e.go",  # keep: e2e-tagged variant; rules_go build-constraint-filters it out of the default build, in for the gotags=["e2e"] binary
        "endpoint_prod.go",
        "github.go",
        "linear.go",
        "main.go",
        "plugin.go",
        "server.go",
    ],
    importpath = "github.com/recurser/bossd-plugin-linear",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/plugin",
        "@com_github_hashicorp_go_plugin//:go-plugin",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "bossd-plugin-linear",
    embed = [":bossd-plugin-linear_lib"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "bossd-plugin-linear-e2e",
    embed = [":bossd-plugin-linear_lib"],
    gotags = ["e2e"],  # keep: e2e-tagged build for the host linear integration harness
    visibility = ["//visibility:public"],
)  # keep

go_test(
    name = "bossd-plugin-linear_test",
    srcs = [
        "github_test.go",
        "linear_test.go",
        "server_test.go",
    ],
    embed = [":bossd-plugin-linear_lib"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "@com_github_rs_zerolog//:zerolog",
    ],
)
