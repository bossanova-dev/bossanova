load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "bossd-plugin-opencode_lib",
    srcs = [
        "auth.go",
        "cap.go",
        "dirty_files.go",
        "host.go",
        "main.go",
        "opencodedb.go",
        "plugin.go",
        "questionhook.go",
        "runner.go",
        "server.go",
    ],
    embedsrcs = ["bossd-question.js"],
    importpath = "github.com/recurser/bossd-plugin-opencode",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/bossalib/agenterr",
        "//lib/bossalib/agentruntime",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/loginshell",
        "//lib/bossalib/plugin",
        "//lib/bossalib/plugin/hostclient",
        "//lib/bossalib/safego",
        "@com_github_hashicorp_go_plugin//:go-plugin",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_modernc_sqlite//:sqlite",
    ],
)

go_binary(
    name = "bossd-plugin-opencode",
    embed = [":bossd-plugin-opencode_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bossd-plugin-opencode_test",
    srcs = [
        "auth_test.go",
        "cap_test.go",
        "exitstatus_test.go",
        "live_test.go",
        "main_test.go",
        "opencodedb_test.go",
        "questionhook_asset_exec_test.go",
        "questionhook_test.go",
        "runner_test.go",
        "server_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":bossd-plugin-opencode_lib"],
    # keep: TestEmbeddedQuestionHookAssetExecutes runs the embedded
    # bossd-question.js through a host JS runtime, which needs the developer's
    # real PATH (node is commonly a version-manager shim) and HOME. Without
    # these it silently t.Skip()s, leaving the shipped asset with no executable
    # coverage on the gate. Two consequences to know about: the target can now
    # see a real opencode install where one exists (live_test.go's suite is
    # opt-in behind OPENCODE_LIVE=1, but runner_test.go's
    # TestLiveOpencodeRunSkipsWhenAbsent gates on PATH alone and will smoke-run
    # `opencode --version`; it skips on any failure), and because HOME and PATH
    # differ per machine this target is a permanent cross-machine remote-cache
    # miss. Both are cheap: a ~1s uncached run buys real coverage of a shipped
    # runtime asset that would otherwise have none.
    env_inherit = [
        "HOME",
        "PATH",
    ],
    deps = [
        "//lib/bossalib/agenterr",
        "//lib/bossalib/agentruntime",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_modernc_sqlite//:sqlite",
    ],
)
