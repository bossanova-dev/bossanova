load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# Package marker only — required so Gazelle's go_deps.from_file(go_work = "//:go.work")
# can resolve //plugins/bossd-plugin-stub-runner:go.mod as a Bazel label. This module is not yet bazelified
# (its BUILD targets land in BOS-344); it intentionally contains zero targets.

go_library(
    name = "bossd-plugin-stub-runner_lib",
    srcs = [
        "main.go",
        "plugin.go",
        "question.go",
        "server.go",
    ],
    importpath = "github.com/recurser/bossd-plugin-stub-runner",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/bossalib/contract/plugin/plugin",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "@com_github_hashicorp_go_plugin//:go-plugin",
        "@com_github_rs_zerolog//:zerolog",
    ],
)

go_binary(
    name = "bossd-plugin-stub-runner",
    embed = [":bossd-plugin-stub-runner_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bossd-plugin-stub-runner_test",
    srcs = [
        "conformance_test.go",
        "question_test.go",
        "server_test.go",
    ],
    embed = [":bossd-plugin-stub-runner_lib"],
    deps = [
        "//lib/bossalib/contract/plugin/plugin/agentrunnertest",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//test/bufconn",
    ],
)

# Production sources consumed by the host environment-policy guard.
filegroup(
    name = "env_policy_sources",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//services/bossd/internal/plugin:__pkg__"],
)
