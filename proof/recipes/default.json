{
  "$schema": "./schema.json",
  "version": 1,
  "surfaces": [
    {
      "name": "web",
      "kind": "browser",
      "serviceDir": "services/web",
      "specRoot": "tests/e2e/specs",
      "defaultCropToSelector": "#root",
      "stageEnv": { "VITE_E2E": "1" }
    },
    {
      "name": "marketing",
      "kind": "browser",
      "serviceDir": "services/marketing",
      "specRoot": "tests/e2e",
      "defaultCropToSelector": "main"
    },
    {
      "name": "docs",
      "kind": "browser",
      "serviceDir": "services/docs",
      "specRoot": "tests/e2e",
      "defaultCropToSelector": "#root"
    }
  ],
  "recipes": [
    {
      "id": "web-sessions",
      "surface": "web",
      "title": "Web Sessions",
      "description": "Product web sessions list using e2e fixture data.",
      "privacy": "fixture",
      "route": "/",
      "cropToSelector": ".data-table-wrap",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "web-account",
      "surface": "web",
      "title": "Web Account Settings",
      "description": "Product web account settings page in the ACTIVE subscription state, showing the Manage subscription button.",
      "privacy": "fixture",
      "route": "/settings/account",
      "cropToSelector": ".account-billing",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "web-chat-terminal",
      "surface": "web",
      "title": "Web Chat Terminal",
      "description": "Product web terminal route with xterm mounted.",
      "privacy": "fixture",
      "route": "/sessions/sess-e2e-1/chats/claude-1",
      "selector": "[data-testid='chat-terminal-canvas']",
      "canvas": true,
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "web-session-detail",
      "surface": "web",
      "title": "Web Session Detail (passing PR)",
      "description": "Product web session-detail header on a session with a passing PR: the Merge button is visible alongside Archive and Open GitHub. No Stop button, no Branch/PR meta rows, no 'Switch account' button, status pill at left.",
      "privacy": "fixture",
      "route": "/sessions/sess-e2e-1",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "web-session-detail-no-pr",
      "surface": "web",
      "title": "Web Session Detail (no PR / Quick Chat)",
      "description": "Product web session-detail header on a Quick-Chat session with no PR: it shows the session title, New chat, and Archive, but NO Merge button and NO 'Switch account' button.",
      "privacy": "fixture",
      "route": "/sessions/sess-e2e-quick",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "web-session-detail-mobile",
      "surface": "web",
      "title": "Web Session Detail (mobile)",
      "description": "Session-detail header at phone width (390px): the session title is on its own row above the action buttons, left-aligned and truncating with an ellipsis when long; the action buttons sit on the row below, right-aligned. Icon-only chat buttons.",
      "privacy": "fixture",
      "route": "/sessions/sess-e2e-1",
      "viewport": { "width": 390, "height": 844 }
    },
    {
      "id": "web-sessions-mobile",
      "surface": "web",
      "title": "Web Sessions (mobile)",
      "description": "Sessions list at phone width: icon-only New Session button floated right, table flush against the breadcrumb with a single top border.",
      "privacy": "fixture",
      "route": "/",
      "viewport": { "width": 390, "height": 844 }
    },
    {
      "id": "web-new-session-mobile",
      "surface": "web",
      "title": "Web New Session (mobile)",
      "description": "New Session wizard at phone width: symmetric breadcrumb padding and no 'Step N of M' heading.",
      "privacy": "fixture",
      "route": "/sessions/new",
      "viewport": { "width": 390, "height": 844 }
    },
    {
      "id": "web-repositories",
      "surface": "web",
      "title": "Web Repositories",
      "description": "Repositories settings page: the Disconnect button shows a cross icon and still confirms.",
      "privacy": "fixture",
      "route": "/settings/repos",
      "cropToSelector": ".data-table-wrap",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "marketing-home",
      "surface": "marketing",
      "title": "Marketing Home",
      "description": "Marketing homepage first viewport.",
      "privacy": "fixture",
      "route": "/",
      "selector": "main",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "marketing-pricing",
      "surface": "marketing",
      "title": "Marketing Pricing",
      "description": "Marketing pricing page first viewport.",
      "privacy": "fixture",
      "route": "/pricing",
      "selector": "main",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "marketing-changelog",
      "surface": "marketing",
      "title": "Marketing Changelog",
      "description": "Changelog page (page 1) showing seeded release entries with version chips and timestamps.",
      "privacy": "fixture",
      "route": "/changelog",
      "selector": "main",
      "viewport": { "width": 1440, "height": 1400 }
    },
    {
      "id": "web-new-session-flow",
      "surface": "web",
      "title": "Web New Session Flow",
      "description": "Walkthrough of opening a session in the web app (fixture data).",
      "privacy": "fixture",
      "capture": "video",
      "slowMo": 350,
      "cropToSelector": ".data-table-wrap",
      "viewport": { "width": 1440, "height": 1000 },
      "steps": [
        { "action": "goto", "route": "/", "label": "Open home", "caption": "Open the dashboard" },
        {
          "action": "wait",
          "selector": ".data-table-wrap",
          "label": "Sessions list",
          "caption": "Sessions list loads"
        },
        {
          "action": "click",
          "selector": ".data-table-wrap .row-clickable",
          "label": "Open session",
          "caption": "Open a session"
        },
        { "action": "wait", "timeoutMs": 800, "label": "Session view", "caption": "Session view" }
      ]
    },
    {
      "id": "web-shortcut-launcher",
      "surface": "web",
      "title": "Web Shortcut Launcher",
      "description": "Keyboard-shortcut launcher opened with the ? hotkey on the Sessions screen (fixture data). Captured as a flow because the launcher is opened by a keypress (? / Cmd-K), not reachable as a static route.",
      "privacy": "fixture",
      "capture": "video",
      "slowMo": 350,
      "viewport": { "width": 1440, "height": 1000 },
      "steps": [
        { "action": "goto", "route": "/", "label": "Open home", "caption": "Open the dashboard" },
        {
          "action": "wait",
          "selector": ".data-table-wrap",
          "label": "Sessions list",
          "caption": "Sessions list loads"
        },
        {
          "action": "press",
          "key": "?",
          "label": "Open launcher",
          "caption": "Press ? to open the keyboard-shortcut launcher"
        },
        {
          "action": "wait",
          "selector": "[role=\"dialog\"]",
          "label": "Launcher open",
          "caption": "Global + Sessions shortcuts"
        },
        {
          "action": "press",
          "key": "ArrowDown",
          "label": "Move selection",
          "caption": "Arrow-key selection highlight moves down"
        }
      ]
    },
    {
      "id": "web-shortcut-launcher-detail",
      "surface": "web",
      "title": "Web Shortcut Launcher (session detail)",
      "description": "Keyboard-shortcut launcher on a session-detail screen, showing the context-specific Session actions (Open PR / Merge / Archive) absent on the Sessions list (fixture data).",
      "privacy": "fixture",
      "capture": "video",
      "slowMo": 350,
      "viewport": { "width": 1440, "height": 1000 },
      "steps": [
        {
          "action": "goto",
          "route": "/sessions/sess-e2e-1",
          "label": "Open session detail",
          "caption": "Open a session"
        },
        {
          "action": "wait",
          "selector": "main",
          "label": "Session view",
          "caption": "Session view loads"
        },
        {
          "action": "press",
          "key": "?",
          "label": "Open launcher",
          "caption": "Press ? to open the keyboard-shortcut launcher"
        },
        {
          "action": "wait",
          "selector": "[role=\"dialog\"]",
          "label": "Launcher open",
          "caption": "Session-detail shortcuts"
        },
        {
          "action": "press",
          "key": "ArrowDown",
          "label": "Move selection",
          "caption": "Arrow-key selection highlight moves down through session actions"
        }
      ]
    },
    {
      "id": "marketing-home-scroll",
      "surface": "marketing",
      "title": "Marketing Home Scroll",
      "description": "Walkthrough of the marketing homepage (fixture data).",
      "privacy": "fixture",
      "capture": "video",
      "viewport": { "width": 1440, "height": 1000 },
      "steps": [
        { "action": "goto", "route": "/", "caption": "Marketing home" },
        { "action": "wait", "selector": "main", "caption": "Marketing home" },
        { "action": "scroll", "byPx": 900, "caption": "Scroll the page" },
        { "action": "wait", "timeoutMs": 800 }
      ]
    },
    {
      "id": "docs-home",
      "surface": "docs",
      "title": "Docs — Home",
      "description": "Documentation site landing page.",
      "privacy": "fixture",
      "route": "/",
      "selector": "main",
      "viewport": { "width": 1280, "height": 1000 }
    },
    {
      "id": "docs-mcp-guide",
      "surface": "docs",
      "title": "Docs — MCP Guide",
      "description": "Rendered MCP documentation guide page (services/docs/docs/guides/mcp.md).",
      "privacy": "fixture",
      "route": "/guides/mcp",
      "selector": "article",
      "viewport": { "width": 1280, "height": 1000 }
    },
    {
      "id": "docs-upgrade",
      "surface": "docs",
      "title": "Docs — Upgrade",
      "description": "Rendered upgrade documentation page (services/docs/docs/upgrade.md).",
      "privacy": "fixture",
      "route": "/upgrade",
      "selector": "article",
      "viewport": { "width": 1280, "height": 1000 }
    },
    {
      "id": "docs-setup-scripts-guide",
      "surface": "docs",
      "title": "Docs — Setup Scripts Guide",
      "description": "Rendered Setup Scripts documentation guide page (services/docs/docs/guides/setup-scripts.md).",
      "privacy": "fixture",
      "route": "/guides/setup-scripts",
      "selector": "article",
      "viewport": { "width": 1280, "height": 1000 }
    },
    {
      "id": "docs-account-rotation",
      "surface": "docs",
      "title": "Docs — Account Rotation Guide",
      "description": "Rendered Account Rotation documentation guide page (services/docs/docs/guides/account-rotation.md).",
      "privacy": "fixture",
      "route": "/guides/account-rotation",
      "selector": "article",
      "viewport": { "width": 1280, "height": 1000 }
    }
  ],
  "pathRules": [
    {
      "name": "Product web",
      "patterns": ["services/web/"],
      "recipeIds": [
        "web-sessions",
        "web-sessions-mobile",
        "web-session-detail",
        "web-session-detail-no-pr",
        "web-session-detail-mobile",
        "web-new-session-mobile",
        "web-repositories",
        "web-account",
        "web-chat-terminal",
        "web-new-session-flow",
        "web-shortcut-launcher",
        "web-shortcut-launcher-detail"
      ]
    },
    {
      "name": "Marketing site",
      "patterns": ["services/marketing/", "lib/ui-tokens/"],
      "recipeIds": [
        "marketing-home",
        "marketing-pricing",
        "marketing-changelog",
        "marketing-home-scroll"
      ]
    },
    {
      "name": "Docs site",
      "patterns": ["services/docs/"],
      "recipeIds": ["docs-home"]
    },
    {
      "name": "Docs MCP guide",
      "patterns": ["services/docs/docs/guides/mcp"],
      "recipeIds": ["docs-mcp-guide"]
    },
    {
      "name": "Docs upgrade guide",
      "patterns": ["services/docs/docs/upgrade"],
      "recipeIds": ["docs-upgrade"]
    },
    {
      "name": "Docs Setup Scripts guide",
      "patterns": ["services/docs/docs/guides/setup-scripts"],
      "recipeIds": ["docs-setup-scripts-guide"]
    },
    {
      "name": "Docs Account Rotation guide",
      "patterns": ["services/docs/docs/guides/account-rotation"],
      "recipeIds": ["docs-account-rotation"]
    }
  ]
}
