{
  "$schema": "./schema.json",
  "version": 1,
  "recipes": [
    {
      "id": "tui-home",
      "surface": "tui",
      "title": "Boss TUI Home",
      "description": "Home screen showing active sessions and action bar.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "waitForText": "Add dark mode"
    },
    {
      "id": "tui-settings",
      "surface": "tui",
      "title": "Boss TUI Settings",
      "description": "Settings screen reached from the home view.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "keys": ["s"],
      "waitForText": "Settings"
    },
    {
      "id": "tui-new-session",
      "surface": "tui",
      "title": "Boss TUI New Session",
      "description": "New session wizard reached from the home view.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "keys": ["n"],
      "waitForReadyText": "Add dark mode",
      "waitForText": "New Session"
    },
    {
      "id": "tui-new-session-sentry",
      "surface": "tui",
      "title": "Boss TUI New Session — Sentry",
      "description": "Session-type picker showing the 'Fix a Sentry issue' option for a repo with Sentry configured.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "fixture": "demo",
      "steps": [
        {
          "keys": ["n"],
          "waitForReadyText": "Add dark mode",
          "waitForText": "Select a repository"
        },
        { "keys": ["enter"], "waitForText": "Fix a Sentry issue" }
      ],
      "waitForText": "Fix a Sentry issue"
    },
    {
      "id": "tui-repo-list",
      "surface": "tui",
      "title": "Boss TUI Repositories",
      "description": "Registered repositories list.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "steps": [
        { "keys": ["s"], "waitForText": "Settings" },
        { "keys": ["r"], "waitForText": "PATH" }
      ],
      "waitForText": "PATH"
    },
    {
      "id": "tui-repo-add",
      "surface": "tui",
      "title": "Boss TUI Add Repository",
      "description": "Add-repository wizard reached from the repo list.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "fixture": "demo",
      "steps": [
        { "keys": ["s"], "waitForText": "Settings" },
        { "keys": ["r"], "waitForText": "Repositories" },
        { "keys": ["a"], "waitForText": "Add Repository" }
      ],
      "waitForText": "Add Repository"
    },
    {
      "id": "tui-repo-settings",
      "surface": "tui",
      "title": "Boss TUI Repository Settings",
      "description": "Repository settings reached by selecting a repo.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "fixture": "demo",
      "steps": [
        { "keys": ["s"], "waitForText": "Settings" },
        { "keys": ["r"], "waitForText": "Repositories" },
        { "keys": ["enter"], "waitForReadyText": "my-app", "waitForText": "Setup command" }
      ],
      "waitForText": "Setup command"
    },
    {
      "id": "tui-trash",
      "surface": "tui",
      "title": "Boss TUI Trash",
      "description": "Archived sessions (trash) with a restorable session.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "steps": [
        { "keys": ["s"], "waitForText": "Settings" },
        { "keys": ["t"], "waitForText": "Old caching spike" }
      ],
      "waitForText": "Old caching spike"
    },
    {
      "id": "tui-chat-picker",
      "surface": "tui",
      "title": "Boss TUI Chat Picker",
      "description": "Chat list for a session reached with Enter.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "keys": ["enter"],
      "waitForReadyText": "Add dark mode",
      "waitForText": "Initial implementation"
    },
    {
      "id": "tui-session-settings",
      "surface": "tui",
      "title": "Boss TUI Session Settings",
      "description": "Session settings reached from the chat picker.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "fixture": "demo",
      "steps": [
        {
          "keys": ["enter"],
          "waitForReadyText": "Add dark mode",
          "waitForText": "Initial implementation"
        },
        { "keys": ["s"], "waitForText": "Name:" }
      ],
      "waitForText": "Name:"
    },
    {
      "id": "tui-login",
      "surface": "tui",
      "title": "Boss TUI Login",
      "description": "Device-code login screen (logged-out fixture).",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "fixture": "login",
      "keys": ["l"],
      "waitForText": "Login"
    },
    {
      "id": "tui-bug-report",
      "surface": "tui",
      "title": "Boss TUI Bug Report",
      "description": "Bug-report modal opened with Ctrl+B.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "keys": ["ctrl+b"],
      "waitForText": "Report a bug"
    },
    {
      "id": "tui-cron",
      "surface": "tui",
      "title": "Boss TUI Scheduled Jobs",
      "description": "Cron job list with a scheduled job.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "steps": [
        { "keys": ["s"], "waitForText": "Settings" },
        { "keys": ["c"], "waitForText": "Daily dependency update" }
      ],
      "waitForText": "Daily dependency update"
    },
    {
      "id": "tui-cron-form",
      "surface": "tui",
      "title": "Boss TUI Cron Form",
      "description": "Create-cron-job form reached from the cron list, including the cadence/window/schedule fields.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 60 },
      "fixture": "demo",
      "steps": [
        { "keys": ["s"], "waitForText": "Settings" },
        { "keys": ["c"], "waitForText": "Scheduled Jobs" },
        { "keys": ["n"], "waitForText": "Run setup command" }
      ],
      "waitForText": "Run setup command"
    },
    {
      "id": "tui-onboarding",
      "surface": "tui",
      "title": "Boss TUI Onboarding",
      "description": "First-run provider onboarding screen.",
      "privacy": "fixture",
      "terminal": { "width": 140, "height": 36 },
      "fixture": "onboarding",
      "waitForText": "Welcome to Bossanova"
    },
    {
      "id": "tui-new-session-flow",
      "surface": "tui",
      "title": "Boss TUI — New Session Flow",
      "description": "Animated walkthrough: home → new session wizard.",
      "privacy": "fixture",
      "capture": "video",
      "fixture": "demo",
      "terminal": { "width": 140, "height": 36 },
      "frameDelayMs": 500,
      "steps": [
        { "keys": ["n"], "waitForReadyText": "Add dark mode", "waitForText": "New Session" },
        { "keys": ["enter"], "waitForText": "Create a new PR" }
      ]
    },
    {
      "id": "tui-repo-settings-flow",
      "surface": "tui",
      "title": "Boss TUI — Repository Settings: Automations & Integrations",
      "description": "Walkthrough: home → settings → repositories → repo settings, showing the new Automations heading grouping the automation toggles (Mark ready / Auto-merge Dependabot / Automatic repair) above the Integrations heading (Linear / Sentry). The cursor traverses the toggles to show the grouping.",
      "privacy": "fixture",
      "capture": "video",
      "fixture": "demo",
      "terminal": { "width": 140, "height": 36 },
      "frameDelayMs": 750,
      "steps": [
        { "keys": ["s"], "waitForText": "Settings" },
        { "keys": ["r"], "waitForText": "Repositories" },
        { "keys": ["enter"], "waitForReadyText": "my-app", "waitForText": "Automations" },
        { "keys": ["j"], "waitForText": "Mark ready for review when checks pass" },
        { "keys": ["j"], "waitForText": "Auto-merge Dependabot PRs" },
        { "keys": ["j"], "waitForText": "Automatic repair (failing checks, conflicts, review feedback)" },
        { "keys": ["j"], "waitForText": "Integrations" },
        { "keys": ["j"], "waitForText": "Linear" }
      ]
    },
    {
      "id": "tui-grand-tour",
      "surface": "tui",
      "title": "Boss TUI — Grand Tour",
      "description": "Multi-screen walkthrough: settings, repos, add-repo, trash, cron, chat picker, session settings, and the new-session wizard, returning home between branches.",
      "privacy": "fixture",
      "capture": "video",
      "fixture": "demo",
      "terminal": { "width": 140, "height": 36 },
      "frameDelayMs": 950,
      "steps": [
        { "keys": ["s"], "waitForReadyText": "Add dark mode", "waitForText": "Settings" },
        { "keys": ["r"], "waitForText": "PATH" },
        { "keys": ["a"], "waitForText": "Add Repository" },
        { "keys": ["esc"], "waitForText": "PATH" },
        { "keys": ["esc"], "waitForText": "Settings" },
        { "keys": ["t"], "waitForText": "Old caching spike" },
        { "keys": ["esc"], "waitForText": "Settings" },
        { "keys": ["c"], "waitForText": "Daily dependency update" },
        { "keys": ["esc"], "waitForText": "Settings" },
        { "keys": ["esc"], "waitForText": "Add dark mode" },
        {
          "keys": ["enter"],
          "waitForReadyText": "Add dark mode",
          "waitForText": "Initial implementation"
        },
        { "keys": ["s"], "waitForText": "Name:" },
        { "keys": ["esc"], "waitForText": "Initial implementation" },
        { "keys": ["esc"], "waitForText": "Fix login bug" },
        { "keys": ["n"], "waitForReadyText": "Add dark mode", "waitForText": "New Session" },
        { "keys": ["enter"], "waitForText": "Create a new PR" }
      ]
    },
    {
      "id": "web-sessions",
      "surface": "web",
      "title": "Web Sessions",
      "description": "Product web sessions list using e2e fixture data.",
      "privacy": "fixture",
      "route": "/",
      "cropToSelector": ".data-table-wrap",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "web-account",
      "surface": "web",
      "title": "Web Account Settings",
      "description": "Product web account settings page in the ACTIVE subscription state, showing the Manage subscription button.",
      "privacy": "fixture",
      "route": "/settings/account",
      "cropToSelector": ".account-billing",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "web-chat-terminal",
      "surface": "web",
      "title": "Web Chat Terminal",
      "description": "Product web terminal route with xterm mounted.",
      "privacy": "fixture",
      "route": "/sessions/sess-e2e-1/chats/claude-1",
      "selector": "[data-testid='chat-terminal-canvas']",
      "canvas": true,
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "web-session-detail",
      "surface": "web",
      "title": "Web Session Detail",
      "description": "Product web session-detail view: GitHub-logo action button, no Stop button, no Branch/PR meta rows, status pill at left.",
      "privacy": "fixture",
      "route": "/sessions/sess-e2e-1",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "web-session-detail-mobile",
      "surface": "web",
      "title": "Web Session Detail (mobile)",
      "description": "Session-detail at phone width: status pill left, action buttons right, icon-only chat buttons.",
      "privacy": "fixture",
      "route": "/sessions/sess-e2e-1",
      "viewport": { "width": 390, "height": 844 }
    },
    {
      "id": "web-sessions-mobile",
      "surface": "web",
      "title": "Web Sessions (mobile)",
      "description": "Sessions list at phone width: icon-only New Session button floated right, table flush against the breadcrumb with a single top border.",
      "privacy": "fixture",
      "route": "/",
      "viewport": { "width": 390, "height": 844 }
    },
    {
      "id": "web-new-session-mobile",
      "surface": "web",
      "title": "Web New Session (mobile)",
      "description": "New Session wizard at phone width: symmetric breadcrumb padding and no 'Step N of M' heading.",
      "privacy": "fixture",
      "route": "/sessions/new",
      "viewport": { "width": 390, "height": 844 }
    },
    {
      "id": "web-repositories",
      "surface": "web",
      "title": "Web Repositories",
      "description": "Repositories settings page: the Disconnect button shows a cross icon and still confirms.",
      "privacy": "fixture",
      "route": "/settings/repos",
      "cropToSelector": ".data-table-wrap",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "marketing-home",
      "surface": "marketing",
      "title": "Marketing Home",
      "description": "Marketing homepage first viewport.",
      "privacy": "fixture",
      "route": "/",
      "selector": "main",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "marketing-pricing",
      "surface": "marketing",
      "title": "Marketing Pricing",
      "description": "Marketing pricing page first viewport.",
      "privacy": "fixture",
      "route": "/pricing",
      "selector": "main",
      "viewport": { "width": 1440, "height": 1000 }
    },
    {
      "id": "marketing-changelog",
      "surface": "marketing",
      "title": "Marketing Changelog",
      "description": "Changelog page (page 1) showing seeded release entries with version chips and timestamps.",
      "privacy": "fixture",
      "route": "/changelog",
      "selector": "main",
      "viewport": { "width": 1440, "height": 1400 }
    },
    {
      "id": "web-new-session-flow",
      "surface": "web",
      "title": "Web New Session Flow",
      "description": "Walkthrough of opening a session in the web app (fixture data).",
      "privacy": "fixture",
      "capture": "video",
      "slowMo": 350,
      "cropToSelector": ".data-table-wrap",
      "viewport": { "width": 1440, "height": 1000 },
      "steps": [
        { "action": "goto", "route": "/", "label": "Open home", "caption": "Open the dashboard" },
        {
          "action": "wait",
          "selector": ".data-table-wrap",
          "label": "Sessions list",
          "caption": "Sessions list loads"
        },
        {
          "action": "click",
          "selector": ".data-table-wrap .row-clickable",
          "label": "Open session",
          "caption": "Open a session"
        },
        { "action": "wait", "timeoutMs": 800, "label": "Session view", "caption": "Session view" }
      ]
    },
    {
      "id": "marketing-home-scroll",
      "surface": "marketing",
      "title": "Marketing Home Scroll",
      "description": "Walkthrough of the marketing homepage (fixture data).",
      "privacy": "fixture",
      "capture": "video",
      "viewport": { "width": 1440, "height": 1000 },
      "steps": [
        { "action": "goto", "route": "/", "caption": "Marketing home" },
        { "action": "wait", "selector": "main", "caption": "Marketing home" },
        { "action": "scroll", "byPx": 900, "caption": "Scroll the page" },
        { "action": "wait", "timeoutMs": 800 }
      ]
    },
    {
      "id": "docs-home",
      "surface": "docs",
      "title": "Docs — Home",
      "description": "Documentation site landing page.",
      "privacy": "fixture",
      "route": "/",
      "selector": "main",
      "viewport": { "width": 1280, "height": 1000 }
    },
    {
      "id": "docs-mcp-guide",
      "surface": "docs",
      "title": "Docs — MCP Guide",
      "description": "Rendered MCP documentation guide page (services/docs/docs/guides/mcp.md).",
      "privacy": "fixture",
      "route": "/guides/mcp",
      "selector": "article",
      "viewport": { "width": 1280, "height": 1000 }
    }
  ],
  "pathRules": [
    {
      "name": "TUI views",
      "patterns": [
        "services/boss/internal/views/",
        "services/boss/internal/tuitest/",
        "services/boss/internal/tuidriver/",
        "services/boss/internal/fixtures/"
      ],
      "recipeIds": [
        "tui-home",
        "tui-settings",
        "tui-new-session",
        "tui-new-session-sentry",
        "tui-repo-list",
        "tui-repo-add",
        "tui-repo-settings",
        "tui-trash",
        "tui-chat-picker",
        "tui-session-settings",
        "tui-login",
        "tui-bug-report",
        "tui-cron",
        "tui-cron-form",
        "tui-onboarding",
        "tui-new-session-flow",
        "tui-repo-settings-flow"
      ]
    },
    {
      "name": "Product web",
      "patterns": ["services/web/"],
      "recipeIds": [
        "web-sessions",
        "web-sessions-mobile",
        "web-session-detail",
        "web-session-detail-mobile",
        "web-new-session-mobile",
        "web-repositories",
        "web-account",
        "web-chat-terminal",
        "web-new-session-flow"
      ]
    },
    {
      "name": "Marketing site",
      "patterns": ["services/marketing/", "lib/ui-tokens/"],
      "recipeIds": [
        "marketing-home",
        "marketing-pricing",
        "marketing-changelog",
        "marketing-home-scroll"
      ]
    },
    {
      "name": "TUI client/cmd/proto",
      "patterns": ["services/boss/internal/client/", "services/boss/cmd/", "proto/"],
      "recipeIds": ["tui-home", "tui-cron", "tui-settings"]
    },
    {
      "name": "Docs site",
      "patterns": ["services/docs/"],
      "recipeIds": ["docs-home"]
    },
    {
      "name": "Docs MCP guide",
      "patterns": ["services/docs/docs/guides/mcp"],
      "recipeIds": ["docs-mcp-guide"]
    }
  ]
}
