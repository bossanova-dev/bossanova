{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bossanova.dev/schemas/proof-recipes.schema.json",
  "title": "Bossanova Proof Screenshot Recipes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recipes", "pathRules"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "recipes": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipe" },
      "minItems": 1
    },
    "pathRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathRule" }
    },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "surfaceName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "serviceDir", "specRoot", "defaultCropToSelector"],
      "properties": {
        "name": { "$ref": "#/$defs/surfaceName" },
        "kind": { "enum": ["browser"] },
        "serviceDir": { "type": "string", "minLength": 1 },
        "specRoot": { "type": "string", "minLength": 1 },
        "defaultCropToSelector": { "type": "string", "minLength": 1 },
        "stageEnv": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "pathRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "patterns", "recipeIds"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "patterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "recipeIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "recipe": {
      "$ref": "#/$defs/browserRecipe"
    },
    "baseRecipe": {
      "type": "object",
      "required": ["id", "surface", "title", "description", "privacy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "surface": { "$ref": "#/$defs/surfaceName" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "privacy": { "enum": ["fixture", "live"] }
      }
    },
    "browserRecipe": {
      "allOf": [
        { "$ref": "#/$defs/baseRecipe" },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["id", "surface", "title", "description", "privacy", "viewport"],
          "properties": {
            "id": { "type": "string" },
            "surface": { "$ref": "#/$defs/surfaceName" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "privacy": { "enum": ["fixture", "live"] },
            "capture": {
              "enum": ["image", "still", "video"],
              "default": "video",
              "description": "Artifact kind. \"still\"/\"image\" opt out of video and produce one PNG through the still path in scripts/proof-playwright-runner.mjs buildSpec. The default \"video\" records a webm plus a per-step still for every step and a poster PNG; normalizeRecipe (scripts/proof-lib.mjs) synthesises a goto/wait/scroll step sequence for a route-only recipe, so a recipe with no steps still becomes a video."
            },
            "slowMo": { "type": "integer", "minimum": 0, "maximum": 60000 },
            "route": {
              "type": "string",
              "pattern": "^/(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F]).*$"
            },
            "selector": {
              "type": "string",
              "description": "STILL PATH ONLY (capture \"still\"/\"image\"): screenshot ONLY this element. Nothing outside its own box is in frame, so a required proof naming page chrome or surrounding furniture is unobtainable while this is set — drop \"selector\" for a full-viewport capture instead of widening it. Mutually exclusive in effect with \"cropToSelector\", which is evaluated first. On the DEFAULT \"video\" capture buildVideoSpec never reads this field at all: the poster is a full-viewport screenshot and the per-step stills crop to \"cropToSelector\" or the surface's defaultCropToSelector, so \"selector\" excludes nothing there."
            },
            "cropToSelector": {
              "type": "string",
              "description": "Full-width TOP SLICE, not a box crop: the screenshot runs from the viewport origin (0,0) down to box.y + box.height + 24 (clamped to the viewport height), so everything ABOVE the element — header and chrome — is in frame and only the empty space below the element is trimmed. Do not describe such a still as 'cropped to' the element. On the still path only, audit text for this branch is harvested from just those nodes whose top edge sits above the clip height; a \"video\" recipe's audit.txt is still harvested from the whole <body>."
            },
            "fullPage": {
              "type": "boolean",
              "default": false,
              "description": "Only consulted on the still path's plain-viewport branch: \"cropToSelector\" and \"selector\" both take precedence and ignore it, and the default \"video\" capture ignores it too."
            },
            "canvas": {
              "type": "boolean",
              "default": false,
              "description": "Authoring marker for a recipe whose subject is a <canvas> (for example the xterm terminal pane). The runner never reads it — it changes no capture geometry. Because a DOM audit cannot see canvas pixels, a guard in scripts/proof-lib.test.mjs requires every canvas recipe in the shipped catalog to use privacy \"fixture\" (a consumer BOSS_PROOF_CATALOG recipe is not covered by it)."
            },
            "viewport": {
              "type": "object",
              "description": "Capture size in CSS pixels. Keep the width at or below 1024 for small-control evidence: the fresh-context judge downscales any still whose long edge exceeds JUDGE_MAX_PX (1024, scripts/proof-judge.mjs) and the runner sets no deviceScaleFactor, so widening past 1024 makes glyphs SMALLER at the judge, not larger.",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
                "height": { "type": "integer", "minimum": 480, "maximum": 2160 }
              }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action"],
                "properties": {
                  "action": {
                    "enum": ["goto", "click", "type", "press", "select", "reload", "wait", "scroll"]
                  },
                  "label": { "type": "string", "minLength": 1 },
                  "caption": { "type": "string", "minLength": 1 },
                  "key": { "type": "string", "minLength": 1 },
                  "route": {
                    "type": "string",
                    "pattern": "^/(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F]).*$"
                  },
                  "selector": { "type": "string", "minLength": 1 },
                  "value": { "type": "string" },
                  "timeoutMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
                  "toSelector": { "type": "string", "minLength": 1 },
                  "byPx": { "type": "integer", "minimum": -100000, "maximum": 100000 },
                  "fullPage": { "type": "boolean" }
                },
                "allOf": [
                  {
                    "if": { "properties": { "action": { "const": "goto" } } },
                    "then": { "required": ["route"] }
                  },
                  {
                    "if": { "properties": { "action": { "const": "click" } } },
                    "then": { "required": ["selector"] }
                  },
                  {
                    "if": { "properties": { "action": { "const": "type" } } },
                    "then": {
                      "required": ["selector", "value"],
                      "properties": { "value": { "minLength": 1 } }
                    }
                  },
                  {
                    "if": {
                      "properties": { "action": { "const": "press" } },
                      "required": ["action"]
                    },
                    "then": { "required": ["key"] }
                  },
                  {
                    "if": {
                      "properties": { "action": { "const": "select" } },
                      "required": ["action"]
                    },
                    "then": { "required": ["selector", "value"] }
                  },
                  {
                    "if": {
                      "properties": { "action": { "const": "scroll" } },
                      "required": ["action"]
                    },
                    "then": {
                      "anyOf": [
                        { "required": ["toSelector"] },
                        { "required": ["byPx"] },
                        { "required": ["fullPage"] }
                      ]
                    }
                  }
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "canvas": { "const": true } },
                "required": ["canvas"]
              },
              "then": {
                "description": "Canvas surfaces render pixels the DOM-text secret scan cannot inspect, so they must use staged fixture data only.",
                "properties": { "privacy": { "const": "fixture" } }
              }
            },
            {
              "if": {
                "properties": { "capture": { "const": "video" } },
                "required": ["capture"]
              },
              "then": {
                "description": "Video recipes either carry a top-level route (default steps synthesized at runtime) or an explicit steps[] sequence.",
                "anyOf": [{ "required": ["route"] }, { "required": ["steps"] }]
              },
              "else": {
                "description": "Still recipes screenshot a single route.",
                "required": ["route"]
              }
            }
          ]
        }
      ]
    }
  }
}
