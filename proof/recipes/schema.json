{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bossanova.dev/schemas/proof-recipes.schema.json",
  "title": "Bossanova Proof Screenshot Recipes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recipes", "pathRules"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "recipes": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipe" },
      "minItems": 1
    },
    "pathRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathRule" }
    }
  },
  "$defs": {
    "pathRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "patterns", "recipeIds"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "patterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "recipeIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "recipe": {
      "oneOf": [
        { "$ref": "#/$defs/tuiRecipe" },
        { "$ref": "#/$defs/browserRecipe" }
      ]
    },
    "baseRecipe": {
      "type": "object",
      "required": ["id", "surface", "title", "description", "privacy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "surface": { "enum": ["tui", "web", "marketing"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "privacy": { "enum": ["fixture", "live"] }
      }
    },
    "tuiRecipe": {
      "allOf": [
        { "$ref": "#/$defs/baseRecipe" },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["id", "surface", "title", "description", "privacy", "terminal"],
          "properties": {
            "id": { "type": "string" },
            "surface": { "const": "tui" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "privacy": { "enum": ["fixture", "live"] },
            "capture": { "enum": ["image", "video"], "default": "image" },
            "frameDelayMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
            "terminal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 80, "maximum": 240 },
                "height": { "type": "integer", "minimum": 20, "maximum": 80 }
              }
            },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            },
            "keys": {
              "type": "array",
              "items": { "type": "string" }
            },
            "waitForReadyText": { "type": "string", "minLength": 1 },
            "waitForText": { "type": "string", "minLength": 1 },
            "fixture": { "enum": ["demo", "login", "onboarding"], "default": "demo" },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["keys"],
                "properties": {
                  "keys": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                  "waitForReadyText": { "type": "string", "minLength": 1 },
                  "waitForText": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "capture": { "const": "video" } }, "required": ["capture"] },
              "then": {
                "description": "TUI video recipes drive a steps[] sequence; no single waitForText.",
                "required": ["steps"]
              },
              "else": {
                "description": "TUI still recipes screenshot after a single waitForText anchor.",
                "required": ["waitForText"]
              }
            }
          ]
        }
      ]
    },
    "browserRecipe": {
      "allOf": [
        { "$ref": "#/$defs/baseRecipe" },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["id", "surface", "title", "description", "privacy", "viewport"],
          "properties": {
            "id": { "type": "string" },
            "surface": { "enum": ["web", "marketing"] },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "privacy": { "enum": ["fixture", "live"] },
            "capture": { "enum": ["image", "video"], "default": "image" },
            "slowMo": { "type": "integer", "minimum": 0, "maximum": 60000 },
            "route": {
              "type": "string",
              "pattern": "^/(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F]).*$"
            },
            "selector": { "type": "string" },
            "cropToSelector": { "type": "string" },
            "fullPage": { "type": "boolean", "default": false },
            "canvas": { "type": "boolean", "default": false },
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
                "height": { "type": "integer", "minimum": 480, "maximum": 2160 }
              }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action"],
                "properties": {
                  "action": { "enum": ["goto", "click", "type", "wait", "scroll"] },
                  "label": { "type": "string", "minLength": 1 },
                  "caption": { "type": "string", "minLength": 1 },
                  "route": {
                    "type": "string",
                    "pattern": "^/(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F]).*$"
                  },
                  "selector": { "type": "string", "minLength": 1 },
                  "value": { "type": "string", "minLength": 1 },
                  "timeoutMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
                  "toSelector": { "type": "string", "minLength": 1 },
                  "byPx": { "type": "integer", "minimum": -100000, "maximum": 100000 }
                },
                "allOf": [
                  {
                    "if": { "properties": { "action": { "const": "goto" } } },
                    "then": { "required": ["route"] }
                  },
                  {
                    "if": { "properties": { "action": { "const": "click" } } },
                    "then": { "required": ["selector"] }
                  },
                  {
                    "if": { "properties": { "action": { "const": "type" } } },
                    "then": { "required": ["selector", "value"] }
                  },
                  {
                    "if": { "properties": { "action": { "const": "scroll" } }, "required": ["action"] },
                    "then": { "anyOf": [{ "required": ["toSelector"] }, { "required": ["byPx"] }] }
                  }
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "canvas": { "const": true } },
                "required": ["canvas"]
              },
              "then": {
                "description": "Canvas surfaces render pixels the DOM-text secret scan cannot inspect, so they must use staged fixture data only.",
                "properties": { "privacy": { "const": "fixture" } }
              }
            },
            {
              "if": {
                "properties": { "capture": { "const": "video" } },
                "required": ["capture"]
              },
              "then": {
                "description": "Video recipes drive a steps[] action sequence; routes live in the goto steps, not a single top-level route.",
                "required": ["steps"]
              },
              "else": {
                "description": "Still recipes screenshot a single route.",
                "required": ["route"]
              }
            }
          ]
        }
      ]
    }
  }
}
