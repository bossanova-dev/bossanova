{
  "version": 1,
  "title": "BOS-459 Settings desktop notifications toggle",
  "fixture": { "preset": "demo" },
  "scenes": [
    {
      "id": "scene-01",
      "title": "desktop notifications render enabled in Settings",
      "steps": [
        { "key": "s", "caption": "Open the Settings hub" },
        {
          "waitFor": "[x] Enable desktop notifications for questions",
          "timeoutMs": 10000,
          "caption": "Desktop notifications are enabled by default"
        },
        { "key": "down", "caption": "Move to poll interval" },
        { "key": "down", "caption": "Move to automatic account rotation" },
        { "key": "down", "caption": "Select desktop notifications" },
        {
          "expect": [
            {
              "text": "Enable desktop notifications",
              "match": "normalized",
              "label": "desktop notification setting label"
            },
            {
              "text": "[x] Enable desktop notifications for questions",
              "match": "normalized",
              "label": "desktop notifications enabled checkbox"
            }
          ],
          "caption": "The enabled desktop notification setting is visible"
        }
      ]
    },
    {
      "id": "scene-02",
      "title": "desktop notifications render disabled after toggling",
      "steps": [
        { "key": "enter", "caption": "Disable desktop notifications" },
        {
          "waitFor": "[ ] Enable desktop notifications for questions",
          "timeoutMs": 10000,
          "caption": "Desktop notifications are disabled"
        },
        {
          "expect": [
            {
              "text": "Enable desktop notifications",
              "match": "normalized",
              "label": "desktop notification setting label remains visible"
            },
            {
              "text": "[ ] Enable desktop notifications for questions",
              "match": "normalized",
              "label": "desktop notifications disabled checkbox"
            }
          ],
          "caption": "The disabled desktop notification setting is visible"
        }
      ]
    }
  ]
}
