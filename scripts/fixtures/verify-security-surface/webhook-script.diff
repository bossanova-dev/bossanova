+package sessionwebhook
+
+import (
+	"github.com/dop251/goja"
+)
+
+// formatMessage runs the user-uploaded script stored on the webhook row to shape the outgoing
+// message body.
+func formatMessage(row WebhookRow, event Event) (string, error) {
+	vm := goja.New()
+	_ = vm.Set("event", event)
+	value, err := vm.RunString(row.FormatScript)
+	if err != nil {
+		return "", err
+	}
+	return value.String(), nil
+}
