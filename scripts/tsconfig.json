{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["./**/*.mjs", "../skills-toolbox/**/*.mjs"],
  "exclude": ["./**/*.test.mjs", "../skills-toolbox/**/*.test.mjs", "**/node_modules"]
}
