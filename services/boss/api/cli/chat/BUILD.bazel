load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "chat",
    srcs = ["chat.go"],
    importpath = "github.com/recurser/boss/api/cli/chat",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/bossalib/contract/daemon/chatdelivery",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//services/boss/api/cli/cliutil",
