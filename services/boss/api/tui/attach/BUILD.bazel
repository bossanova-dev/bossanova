        "//services/boss/api/tui/ui",
        "//services/boss/internal/agent",
        "//services/boss/internal/attachprocess",
        "//services/boss/internal/browser",
        "//services/boss/internal/domain/display",
        "//services/boss/internal/domain/rpc",
