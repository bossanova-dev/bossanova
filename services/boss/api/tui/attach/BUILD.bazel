        "//services/boss/internal/pty",
        "//services/boss/internal/remotehost",
        "@com_connectrpc_connect//:connect",
        "@com_github_charmbracelet_x_ansi//:ansi",
        "@land_charm_bubbletea_v2//:bubbletea",
    ],
