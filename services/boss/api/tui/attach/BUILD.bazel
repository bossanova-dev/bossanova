        "client.go",
        "webopen.go",
    ],
    importpath = "github.com/recurser/boss/api/tui/attach",
    visibility = ["//services/boss:__subpackages__"],
    deps = [
        "//lib/bossalib/contract/daemon/termnorm",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
