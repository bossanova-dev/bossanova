go_test(
    name = "login_e2e_test",
    srcs = ["browser_e2e_test.go"],
    embed = [":login"],
    gotags = ["e2e"],
)  # keep: unit tests of the e2e-tagged seams

exports_files(
    [
        "browser_e2e.go",
        "login.go",
        "subscription.go",
    ],
    visibility = ["//services/boss/api/tui:__pkg__"],
