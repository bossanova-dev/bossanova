load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "boss_lib",
    srcs = [
        "chat_commands.go",
        "crossorgsessions_e2e.go",  # keep: e2e-tagged router decorator
        "crossorgsessions_prod.go",
        "daemon_tui.go",
        "daemon_wiring.go",
        "diagnostics_wiring.go",
        "gen_skill.go",
        "hangup.go",
        "main.go",
        "repo_wiring.go",
        "session_commands.go",
        "settings_wiring.go",
        "skills_wiring.go",
        "startup.go",
        "telemetry.go",
    ],
    importpath = "github.com/recurser/boss/cmd/boss",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/bossalib/buildinfo",
        "//lib/bossalib/config",
        "//lib/bossalib/contract/plugin/skillinstall",
        "//lib/bossalib/errortrack",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/log",
        "//lib/bossalib/telemetry",
        "//services/boss/api/cli/account",
        "//services/boss/api/cli/broadcast",
        "//services/boss/api/cli/callback",
        "//services/boss/api/cli/chat",
        "//services/boss/api/cli/cliutil",
        "//services/boss/api/cli/cron",
        "//services/boss/api/cli/daemon",
        "//services/boss/api/cli/diagnostics",
        "//services/boss/api/cli/mcp",
        "//services/boss/api/cli/notes",
        "//services/boss/api/cli/other",
        "//services/boss/api/cli/plugins",
        "//services/boss/api/cli/repo",
        "//services/boss/api/cli/session",
        "//services/boss/api/cli/settings",
        "//services/boss/api/cli/skills",
        "//services/boss/api/cli/trash",
        "//services/boss/api/cli/trigger",
        "//services/boss/api/cli/webhook",
        "//services/boss/api/tui",
        "//services/boss/api/tui/home",
        "//services/boss/api/tui/login",
        "//services/boss/api/tui/repos",
        "//services/boss/api/tui/ui",
        "//services/boss/cmd/skillgen",
        "//services/boss/internal/adapter/cloudrpc",
        "//services/boss/internal/adapter/daemonrpc",
        "//services/boss/internal/adapter/sshhost",
        "//services/boss/internal/auth",
        "//services/boss/internal/daemonlife",
        "//services/boss/internal/domain/clidoc",
        "//services/boss/internal/domain/rpc",
        "//services/boss/internal/preflight",
        "//services/boss/internal/termreset",
        "@com_github_rs_zerolog//:zerolog",
        "@com_github_rs_zerolog//log",
        "@com_github_spf13_cobra//:cobra",
        "@land_charm_bubbletea_v2//:bubbletea",
        "@org_golang_google_protobuf//proto",  # keep: crossorgsessions_e2e.go uses proto with the e2e tag
        "@org_golang_x_term//:term",
    ],
)

go_binary(
    name = "boss",
    embed = [":boss_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "boss_test",
    srcs = [
        "agents_test.go",
        "cloud_gate_startup_test.go",
        "daemon_tui_test.go",
        "daemon_wiring_test.go",
        "fix_terminal_test.go",
        "flagerror_test.go",
        "gen_skill_test.go",
        "hangup_test.go",
        "host_wiring_test.go",
        "skill_coverage_test.go",
        "skill_startup_integration_test.go",
        "startup_test.go",
        "telemetry_test.go",
        "testmain_test.go",
    ],
    embed = [":boss_lib"],
    # keep: skill/upgrade tests go-build the boss binary and install plugins via a
    # runtime.Caller workspace root — genuinely escapes the sandbox. Covered by `make test-boss`.
    tags = [
        "manual",
        "requires-workspace",
    ],
    deps = [
        "//lib/bossalib/config",
        "//lib/bossalib/contract/plugin/skillinstall",
        "//lib/bossalib/contract/plugin/skillpayload",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/telemetry",
        "//services/boss/api/cli/cliutil",
        "//services/boss/api/cli/settings",
        "//services/boss/api/cli/skills",
        "//services/boss/api/tui",
        "//services/boss/api/tui/home",
        "//services/boss/cmd/skillgen",
        "//services/boss/internal/adapter/daemonrpc",
        "//services/boss/internal/auth",
        "//services/boss/internal/domain/rpc",
        "//services/boss/internal/preflight",
        "//services/boss/internal/termreset",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_spf13_pflag//:pflag",
    ],
)

go_test(
    name = "boss_e2e_test",
    srcs = ["crossorgsessions_e2e_test.go"],
    embed = [":boss_lib"],
    gotags = ["e2e"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//services/boss/internal/domain/rpc",
    ],
)  # keep: tests for the e2e-tagged router decorator
