load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "proof-scenario_lib",
    srcs = ["main.go"],
    importpath = "github.com/recurser/boss/cmd/proof-scenario",
    visibility = ["//visibility:private"],
    deps = ["//services/boss/internal/scenario"],
)

go_binary(
    name = "proof-scenario",
    embed = [":proof-scenario_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "proof-scenario_test",
    srcs = ["main_test.go"],
    embed = [":proof-scenario_lib"],
)
