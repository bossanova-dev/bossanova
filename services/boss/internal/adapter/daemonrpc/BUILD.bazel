load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "daemonrpc",
    srcs = [
        "local.go",
        "netns_linux.go",
        "netns_other.go",
        "rpcdeadline.go",
        "rpcdeadline_e2e.go",  # keep: e2e-tagged seam; rules_go filters it out of the default build, in for gotags = ["e2e"] targets
        "rpcdeadline_prod.go",
        "unsupported.go",
    ],
    importpath = "github.com/recurser/boss/internal/adapter/daemonrpc",
    visibility = ["//services/boss:__subpackages__"],
    deps = [
        "//lib/bossalib/contract/daemon/socketauth",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/gen/bossanova/v1/bossanovav1connect",
        "//lib/bossalib/kit/config",
        "//lib/bossalib/kit/daemoncaps",
        "//services/boss/internal/adapter/rpcerror",
        "//services/boss/internal/domain/rpc",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "daemonrpc_test",
    srcs = [
        "local_auth_test.go",
        "local_deadline_test.go",
        "local_path_test.go",
        "local_test.go",
        "local_wrappers_test.go",
        "notes_test.go",
        "organizations_test.go",
        "phase_test.go",
        "rpcdeadline_prod_test.go",
        "rpcerr_test.go",
        "setup_watch_test.go",
        "verify_pr_test.go",
    ],
    embed = [":daemonrpc"],
    deps = [
        "//lib/bossalib/contract/daemon/socketauth",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/gen/bossanova/v1/bossanovav1connect",
        "//lib/bossalib/kit/config",
        "//services/boss/internal/domain/rpc",
        "//services/boss/internal/domain/rpcerr",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "daemonrpc_e2e_test",
    srcs = ["rpcdeadline_e2e_test.go"],
    embed = [":daemonrpc"],
    gotags = ["e2e"],
    deps = ["//lib/bossalib/gen/bossanova/v1/bossanovav1connect"],
)  # keep: unit tests of the e2e-tagged seams
