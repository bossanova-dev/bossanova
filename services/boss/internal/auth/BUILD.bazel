load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "auth",
    srcs = [
        "devicecode.go",
        "e2e_login.go",  # keep: e2e-tagged seam; rules_go filters it out of the default build, in for gotags = ["e2e"] targets
        "e2e_login_prod.go",
        "loginverify.go",
        "manager.go",
        "refresh.go",
        "tokenstore.go",
    ],
    importpath = "github.com/recurser/boss/internal/auth",
    visibility = ["//services/boss:__subpackages__"],
    deps = [
        "//lib/bossalib/contract/daemon/authlock",
        "//lib/bossalib/contract/daemon/authtoken",
        "//lib/bossalib/contract/daemon/keyringutil",
        "//lib/bossalib/kit/safego",
        "@com_github_99designs_keyring//:keyring",
        "@com_github_rs_zerolog//log",
    ],
)

go_test(
    name = "auth_test",
    srcs = [
        "auth_test.go",
        "devicecode_test.go",
        "loginverify_test.go",
        "migration_test.go",
        "refresh_test.go",
        "relogin_test.go",
        "tokenstore_roundtrip_test.go",
        "tokenstore_test.go",
    ],
    embed = [":auth"],
    deps = [
        "@com_github_99designs_keyring//:keyring",
        "@com_github_rs_zerolog//:zerolog",
        "@com_github_rs_zerolog//log",
    ],
