load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "client",
    srcs = [
        "agent.go",
        "client.go",
        "local.go",
        "remote.go",
        "report.go",
    ],
    importpath = "github.com/recurser/boss/internal/client",
    visibility = ["//services/boss:__subpackages__"],
    deps = [
        "//lib/bossalib/apiversion",
        "//lib/bossalib/config",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/gen/bossanova/v1/bossanovav1connect",
        "//lib/bossalib/socketauth",
        "//services/boss/internal/auth",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "client_test",
    srcs = [
        "agent_test.go",
        "local_auth_test.go",
        "local_path_test.go",
        "local_test.go",
        "local_wrappers_test.go",
        "remote_test.go",
    ],
    embed = [":client"],
    deps = [
        "//lib/bossalib/config",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/gen/bossanova/v1/bossanovav1connect",
        "//lib/bossalib/socketauth",
        "@com_connectrpc_connect//:connect",
    ],
)
