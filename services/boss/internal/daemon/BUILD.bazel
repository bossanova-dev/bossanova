load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "daemon",
    srcs = [
        "daemon.go",
        "launchd.go",
        "mcpprocess.go",
        "stage_darwin.go",
        "stage_other.go",
        "systemd.go",
    ],
    importpath = "github.com/recurser/boss/internal/daemon",
    visibility = ["//services/boss:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:darwin": [
            "//lib/bossalib/config",
            "//lib/bossalib/daemonbin",
        ],
        "@rules_go//go/platform:ios": [
            "//lib/bossalib/config",
            "//lib/bossalib/daemonbin",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "daemon_test",
    srcs = [
        "daemon_test.go",
        "launchd_test.go",
        "mcpprocess_test.go",
        "systemd_test.go",
    ],
    embed = [":daemon"],
    deps = select({
        "@rules_go//go/platform:darwin": [
            "//lib/bossalib/config",
            "//lib/bossalib/daemonbin",
        ],
        "@rules_go//go/platform:ios": [
            "//lib/bossalib/config",
            "//lib/bossalib/daemonbin",
        ],
        "//conditions:default": [],
    }),
)
