        "process_test.go",
        "servicepath_test.go",
        "servicesettings_test.go",
        "servingmode_test.go",
        "spawnhistory_test.go",
        "supervisionmode_test.go",
        "systemd_test.go",
        "watchdog_darwin_test.go",
        "watchdog_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":daemonlife"],
    deps = [
        "//lib/bossalib/daemonstate",
        "//lib/bossalib/kit/config",
    ] + select({
        "@rules_go//go/platform:darwin": [
