load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "daemonlife",
    srcs = [
        "daemon.go",
        "launchagent_job.go",
        "launchagent_job_darwin.go",
        "launchagent_job_other.go",
        "launchd.go",
        "mcpprocess.go",
        "process.go",
        "servicepath.go",
        "servicesettings.go",
        "servingmode.go",
        "servingmode_darwin.go",
        "servingmode_other.go",
        "spawnhistory.go",
        "stage_darwin.go",
        "stage_other.go",
        "supervisionmode.go",
        "supervisionmode_darwin.go",
        "supervisionmode_other.go",
        "systemd.go",
        "watchdog.go",
        "watchdog_darwin.go",
        "watchdog_other.go",
    ],
    importpath = "github.com/recurser/boss/internal/daemonlife",
    visibility = ["//services/boss:__subpackages__"],
    deps = [
        "//lib/bossalib/contract/daemon/socketauth",
        "//lib/bossalib/daemonstate",
        "//lib/bossalib/kit/config",
    ] + select({
        "@rules_go//go/platform:darwin": [
            "//lib/bossalib/contract/daemon/daemonbin",
        ],
        "@rules_go//go/platform:ios": [
            "//lib/bossalib/contract/daemon/daemonbin",
        ],
        "//conditions:default": [],
    }),
)

go_test(
