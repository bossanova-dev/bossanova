load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tuidriver",
    srcs = [
        "driver.go",
        "keybytes.go",
    ],
    importpath = "github.com/recurser/boss/internal/tuidriver",
    visibility = ["//services/boss:__subpackages__"],
    deps = [
        "@com_github_charmbracelet_x_vt//:vt",
        "@com_github_creack_pty_v2//:pty",
    ],
)

go_test(
    name = "tuidriver_test",
    srcs = [
        "clamp_test.go",
        "driver_test.go",
        "keybytes_internal_test.go",
        "keybytes_parser_test.go",
        "keybytes_test.go",
        "keyvocab_golden_test.go",
        "rawoutput_test.go",
        "response_loop_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":tuidriver"],
    # keep: driver_test.go spawns a real pty and fork/execs /bin/sh; the Bazel
    # sandbox intermittently denies that ("fork/exec /bin/sh: input/output
    # error" on processwrapper-sandbox, hang on darwin-sandbox). Runs
    # unsandboxed (still covered). See docs/solutions/build-systems/bazel-sandbox-patterns.md.
    tags = [
        "local",
        "no-sandbox",
    ],
    deps = [
        "@com_github_charmbracelet_ultraviolet//:ultraviolet",
        "@com_github_charmbracelet_x_vt//:vt",
    ],
)
