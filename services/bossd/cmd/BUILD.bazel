        "//lib/bossalib/migrate",
        "//lib/bossalib/models",
        "//lib/bossalib/safego",
        "//lib/bossalib/telemetry",
        "//lib/bossalib/vcs",
        "//services/bossd/internal/account",
        "//services/bossd/internal/accountcred",
        "//services/bossd/internal/accountwiring",
        "//services/bossd/internal/agent",
        "//services/bossd/internal/callback",
        "//services/bossd/internal/cron",
        "//services/bossd/internal/db",
        "//services/bossd/internal/git",
        "//services/bossd/internal/plugin",
        "//services/bossd/internal/plugin/eventbus",
        "//services/bossd/internal/proofenvkeyring",
        "//services/bossd/internal/rotation",
