        "filelimit_nondarwin.go",
        "filelimit_other.go",
        "filelimit_unix.go",
        "main.go",
    ],
    importpath = "github.com/recurser/bossd/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/bossalib/apiversion",
        "//lib/bossalib/buildinfo",
        "//lib/bossalib/config",
        "//lib/bossalib/daemonstate",
        "//lib/bossalib/errortrack",
