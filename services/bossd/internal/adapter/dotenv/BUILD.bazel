load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dotenv",
    srcs = ["dotenv.go"],
    importpath = "github.com/recurser/bossd/internal/adapter/dotenv",
    visibility = ["//services/bossd:__subpackages__"],
    deps = [
        "//lib/bossalib/models",
        "//services/bossd/internal/adapter/proofenv",
        "//services/bossd/internal/domain/repotrust",
        "@com_github_rs_zerolog//log",
    ],
)

go_test(
    name = "dotenv_test",
    srcs = ["dotenv_test.go"],
    embed = [":dotenv"],
    deps = [
        "//lib/bossalib/models",
        "//services/bossd/internal/adapter/proofenv",
    ],
)
