load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "github",
    srcs = [
        "actionable_errors.go",
        "background_floor.go",
        "issue.go",
        "pr_comments.go",
        "pr_snapshot.go",
        "provider.go",
        "provider_pr_status.go",
        "ratelimit.go",
        "readcache.go",
    ],
    importpath = "github.com/recurser/bossd/internal/adapter/github",
    visibility = ["//services/bossd:__subpackages__"],
    deps = [
        "//lib/bossalib/kit/vcs",
        "//services/bossd/internal/ghusage",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_x_sync//singleflight",
    ],
)

go_test(
    name = "github_test",
    srcs = [
        "background_floor_test.go",
        "issue_test.go",
        "pr_comments_test.go",
        "pr_snapshot_test.go",
        "provider_body_test.go",
        "provider_e2e_test.go",
        "provider_partial_test.go",
        "provider_test.go",
        "ratelimit_headroom_test.go",
        "ratelimit_test.go",
        "readcache_test.go",
        "review_activity_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":github"],
    deps = [
        "//lib/bossalib/kit/clocktest",
        "//lib/bossalib/kit/vcs",
        "//services/bossd/internal/ghusage",
        "@com_github_rs_zerolog//:zerolog",
    ],
)
