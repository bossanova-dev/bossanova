load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "peercred",
    srcs = [
        "peercred.go",
        "peercred_darwin.go",
        "peercred_linux.go",
        "peercred_other.go",
    ],
    importpath = "github.com/recurser/bossd/internal/adapter/peercred",
    visibility = ["//services/bossd:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:darwin": [
