load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "credsync",
    srcs = [
        "account_gate.go",
        "bootstrap.go",
        "contracts.go",
        "crypto.go",
        "devices.go",
        "engine.go",
        "key_seal.go",
        "readiness.go",
        "recipient.go",
        "rotation.go",
    ],
    importpath = "github.com/recurser/bossd/internal/credsync",
    visibility = ["//services/bossd:__subpackages__"],
    deps = [
        "//services/bossd/internal/devicekey",
        "//services/bossd/internal/domain",
    ],
)

go_test(
    name = "credsync_test",
    srcs = [
        "account_gate_test.go",
        "crypto_test.go",
        "engine_test.go",
        "key_seal_test.go",
        "readiness_test.go",
    ],
    embed = [":credsync"],
    deps = [
        "//services/bossd/internal/devicekey",
        "//services/bossd/internal/domain",
    ],
)
