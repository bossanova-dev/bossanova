load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "db",
    srcs = [
        "account_decide_tx.go",
        "account_store.go",
        "agent_chat_store.go",
        "attempt_store.go",
        "broadcast_store.go",
        "broadcast_subscription_store.go",
        "check_snapshot_store.go",
        "clamp_int32.go",
        "cron_job_store.go",
        "db.go",
        "github_callback_store.go",
        "helpers.go",
        "note_store.go",
        "notifying_chat_store.go",
        "recomputing_stores.go",
        "repo_store.go",
        "rotation_audit_adapter.go",
        "rotation_event_store.go",
        "session_store.go",
        "store.go",
        "task_mapping_store.go",
        "workflow_store.go",
    ],
    importpath = "github.com/recurser/bossd/internal/db",
    visibility = ["//services/bossd:__subpackages__"],
    deps = [
        "//lib/bossalib/config",
        "//lib/bossalib/githubcallback",
        "//lib/bossalib/machine",
        "//lib/bossalib/models",
        "//lib/bossalib/sqlutil",
        "//lib/bossalib/vcs",
        "//services/bossd/internal/rotation",
        "@org_modernc_sqlite//:sqlite",
        "@org_modernc_sqlite//lib",
    ],
)

go_test(
    name = "db_test",
    size = "large",  # keep: race-instrumented modernc SQLite runs the full migration chain per test; medium (300s) is too tight under --config=race
    srcs = [
        "account_decide_tx_test.go",
        "account_store_test.go",
        "agent_chat_store_test.go",
        "broadcast_migration_test.go",
        "broadcast_store_test.go",
        "broadcast_subscription_migration_test.go",
        "broadcast_subscription_store_test.go",
        "cron_job_store_test.go",
        "cron_zero_output_migration_test.go",
        "db_test.go",
        "github_callback_migration_test.go",
        "github_callback_store_test.go",
        "note_migration_test.go",
        "note_store_test.go",
        "notifying_chat_store_test.go",
        "path_test.go",
        "recomputing_stores_test.go",
        "repo_store_test.go",
        "rotation_event_store_test.go",
        "schema_naming_migration_test.go",
        "session_store_test.go",
        "session_tmux_names_test.go",
        "sqlite_pool_test.go",
        "task_mapping_store_test.go",
        "workflow_store_test.go",
    ],
    data = ["//services/bossd/migrations:sql"],  # keep: tests read migrations/*.sql from disk via runtime.Caller
    embed = [":db"],
    rundir = ".",  # keep: run from repo root so runtime.Caller "../../migrations" resolves against staged data
    shard_count = 8,  # keep: split the 170 independent in-memory store tests so per-shard wall-clock stays low under --config=race (~580s serial)
    deps = [
        "//lib/bossalib/config",
        "//lib/bossalib/githubcallback",
        "//lib/bossalib/machine",
        "//lib/bossalib/migrate",
        "//lib/bossalib/models",
        "//lib/bossalib/sqlutil",
        "//services/bossd/internal/rotation",
    ],
)
