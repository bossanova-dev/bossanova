load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "evidence",
    srcs = [
        "evidence.go",
        "open_items.go",
        "operator_record.go",
        "proof.go",
        "reader.go",
    ],
    importpath = "github.com/recurser/bossd/internal/evidence",
    visibility = ["//services/bossd:__subpackages__"],
    deps = [
        "//lib/bossalib/attention",
        "//lib/bossalib/kit/vcs",
        "@com_github_rs_zerolog//:zerolog",
    ],
)

go_test(
    name = "evidence_test",
    srcs = [
        "evidence_test.go",
        "golden_test.go",
        "open_items_test.go",
        "operator_record_test.go",
        "parse_open_items_test.go",
        "proof_test.go",
        "provider_contract_test.go",
        "reader_proof_test.go",
        "reader_test.go",
        "sent_back_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":evidence"],
    deps = [
        "//lib/bossalib/kit/vcs",
        "//services/bossd/internal/adapter/github",
        "//services/bossd/testharness",
        "@com_github_rs_zerolog//:zerolog",
    ],
