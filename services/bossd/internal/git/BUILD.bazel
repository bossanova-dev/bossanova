load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "git",
    srcs = [
        "pathsafety.go",
        "push_provenance.go",
        "redact.go",
        "worktree.go",
    ],
    importpath = "github.com/recurser/bossd/internal/git",
    visibility = ["//services/bossd:__subpackages__"],
    deps = [
        "//lib/bossalib/config",
        "//lib/bossalib/gitremote",
        "//lib/bossalib/keyedgate",
        "//lib/bossalib/setupscript",
        "@com_github_rs_zerolog//:zerolog",
        "@com_github_rs_zerolog//log",
    ],
)

go_test(
    name = "git_test",
    srcs = [
        "keepcurrent_test.go",
        "pathsafety_test.go",
        "push_provenance_test.go",
        "redact_test.go",
        "worktree_bazel_test.go",
        "worktree_bootstrap_test.go",
        "worktree_clone_credentials_test.go",
        "worktree_gitremote_test.go",
        "worktree_perms_test.go",
        "worktree_reflock_test.go",
        "worktree_sshmultiplex_test.go",
        "worktree_test.go",
    ],
    embed = [":git"],
    shard_count = 4,  # keep: 89s unsharded under --config=race on an M-series laptop, about 220s with the 2.5x laptop-to-CI headroom scripts/race-budgets.json budgets for, too close to the medium (300s) ceiling
    deps = [
        "//lib/bossalib/gitremote",
        "@com_github_rs_zerolog//:zerolog",
        "@com_github_rs_zerolog//log",
    ],
)
