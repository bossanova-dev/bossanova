load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mcpcontract",
    srcs = ["doc.go"],
    importpath = "github.com/recurser/bossd/internal/mcpcontract",
    visibility = ["//services/bossd:__subpackages__"],
)

go_test(
    name = "mcpcontract_test",
    srcs = ["contract_test.go"],
    data = ["//services/bossd/migrations:sql"],  # keep: testharness reads migrations/*.sql from disk via runtime.Caller
    embed = [":mcpcontract"],
    rundir = ".",  # keep: run from repo root so runtime.Caller "../../migrations" resolves against staged data
    deps = [
        "//lib/bossalib/bossmcp",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//services/bossd/internal/testharness",
        "@com_connectrpc_connect//:connect",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)
