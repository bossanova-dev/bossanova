load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "rotation",
    srcs = [
        "audit.go",
        "chat_rotator.go",
        "engine.go",
        "rotation_audit_adapter.go",
        "usage_probe.go",
        "util.go",
    ],
    importpath = "github.com/recurser/bossd/internal/rotation",
    visibility = ["//services/bossd:__subpackages__"],
    deps = [
        "//lib/bossalib/contract/cloud/sqlutil",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/kit/config",
        "//lib/bossalib/kit/safego",
        "//lib/bossalib/kit/telemetry",
        "//services/bossd/internal/db",
        "//services/bossd/internal/domain",
        "//services/bossd/internal/domain/telemetry",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_x_sync//singleflight",
    ],
)

go_test(
    name = "rotation_test",
    srcs = [
        "audit_test.go",
        "chat_rotator_integration_test.go",
        "chat_rotator_test.go",
        "dochan_ratchet_test.go",
        "engine_test.go",
        "fakestore_test.go",
        "out_of_service_test.go",
        "proactive_sweep_test.go",
        "proxy_token_repair_test.go",
        "util_test.go",
    ],
    data = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),  # keep: TestNoRawDoChanCallInThisPackage parses this package's own sources from disk
    embed = [":rotation"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/kit/config",
        "//lib/bossalib/kit/telemetry",
        "//services/bossd/internal/db",
        "//services/bossd/internal/detach/detachgate",
        "//services/bossd/internal/domain",
        "//services/bossd/internal/status",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
