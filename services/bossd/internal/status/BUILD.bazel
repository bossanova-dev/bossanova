load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "status",
    srcs = [
        "clamp_int32.go",
        "display_computer.go",
        "display_tracker.go",
        "recomputing_stores.go",
        "repair_lease.go",
        "tmux_idle_reap.go",
        "tmux_poller.go",
        "tmux_reaper.go",
        "tmux_terminal_observer.go",
        "tracker.go",
        "turn_start.go",
    ],
    importpath = "github.com/recurser/bossd/internal/status",
    visibility = ["//services/bossd:__subpackages__"],
    deps = [
        "//lib/bossalib/agenttelemetry",
        "//lib/bossalib/config",
        "//lib/bossalib/displaystatus",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/machine",
        "//lib/bossalib/models",
        "//lib/bossalib/safego",
        "//lib/bossalib/statusdetect",
        "//lib/bossalib/vcs",
        "//services/bossd/internal/adapter/tmux",
        "//services/bossd/internal/agent",
        "//services/bossd/internal/db",
        "//services/bossd/internal/domain",
        "//services/bossd/internal/domain/questionsignal",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "status_test",
    srcs = [
        "background_agents_test.go",
        "display_computer_test.go",
        "display_tracker_test.go",
        "phase_test.go",
        "recomputing_stores_test.go",
        "repair_lease_test.go",
        "tmux_idle_reap_test.go",
        "tmux_poller_test.go",
        "tmux_reaper_test.go",
        "tmux_terminal_observer_test.go",
        "tracker_test.go",
        "turn_start_test.go",
        "waiting_test.go",
    ],
    data = ["//services/bossd/migrations:sql"],  # keep: tests read migrations/*.sql from disk via runtime.Caller
    embed = [":status"],
    rundir = ".",  # keep: run from repo root so runtime.Caller "../../migrations" resolves against staged data
    shard_count = 4,  # keep: 81s unsharded under --config=race on an M-series laptop, about 200s with the 2.5x laptop-to-CI headroom scripts/race-budgets.json budgets for, too close to the medium (300s) ceiling
    deps = [
        "//lib/bossalib/agenttelemetry",
        "//lib/bossalib/config",
        "//lib/bossalib/displaystatus",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/machine",
        "//lib/bossalib/migrate",
        "//lib/bossalib/models",
        "//lib/bossalib/statusdetect",
        "//lib/bossalib/vcs",
        "//services/bossd/internal/adapter/tmux",
        "//services/bossd/internal/agent",
        "//services/bossd/internal/broadcast",
        "//services/bossd/internal/db",
        "//services/bossd/internal/dbtest",
        "//services/bossd/internal/domain",
        "//services/bossd/internal/domain/questionsignal",
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
