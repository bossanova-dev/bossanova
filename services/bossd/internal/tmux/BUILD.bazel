load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tmux",
    srcs = [
        "attach.go",
        "intconv.go",
        "ready_marker.go",
        "tmux.go",
        "tmux_modal.go",
        "tmux_submit_verify.go",
    ],
    importpath = "github.com/recurser/bossd/internal/tmux",
    visibility = ["//services/bossd:__subpackages__"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/termnorm",
        "@com_github_creack_pty_v2//:pty",
        "@com_github_rs_zerolog//:zerolog",
    ],
)

go_test(
    name = "tmux_test",
    srcs = [
        "attach_test.go",
        "intconv_test.go",
        "list_sessions_test.go",
        "tmux_budget_test.go",
        "tmux_delivery_deadline_test.go",
        "tmux_e2e_test.go",
        "tmux_modal_test.go",
        "tmux_modal_wrappers_test.go",
        "tmux_ready_retry_test.go",
        "tmux_submit_verify_codex_test.go",
        "tmux_submit_verify_queued_test.go",
        "tmux_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":tmux"],
    deps = [
        "//lib/bossalib/config",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/plugin/hostclient",
        "//lib/bossalib/statusdetect",
    ],
)
