load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "migrations",
    srcs = ["embed.go"],
    # A glob mirrors `//go:embed *.sql`, so a new migration needs no BUILD edit; gazelle's
    # explicit list appended every migration at its end and conflicted.
    embedsrcs = glob(["*.sql"]),  # keep
    importpath = "github.com/recurser/bossd/migrations",
    visibility = ["//visibility:public"],
)

# keep: raw migration SQL exposed as a filegroup so tests that read the
# migrations directory from disk via runtime.Caller (db, status, server,
# testharness consumers) find services/bossd/migrations/*.sql in their runfiles.
filegroup(
    name = "sql",
    srcs = glob(["*.sql"]),
    visibility = ["//services/bossd:__subpackages__"],
)
