{
  "name": "bossanova-docs",
  "description": "Bossanova end-user documentation site (Docusaurus).",
  "version": "0.0.0",
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "^3.8.0",
    "@docusaurus/preset-classic": "^3.8.0",
    "@docusaurus/theme-mermaid": "^3.8.0",
    "@easyops-cn/docusaurus-search-local": "^0.49.2",
    "@mdx-js/react": "^3.0.0",
    "@sentry/react": "^10.53.1",
    "asciinema-player": "^3.15.1",
    "clsx": "^2.1.0",
    "posthog-js": "^1.373.4",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "redocusaurus": "^2.5.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.8.0",
    "@docusaurus/tsconfig": "^3.8.0",
    "@docusaurus/types": "^3.8.0",
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "@docusaurus/theme-common": "3.10.1",
      "websocket-driver": "0.7.5",
      "shell-quote": "1.9.0",
      "fast-uri": "3.1.5",
      "fast-xml-parser": "5.10.1",
      "svgo": "3.3.4",
      "gray-matter>js-yaml": "3.15.1",
      "js-yaml": "4.3.1",
      "brace-expansion": "1.1.18",
      "undici": "7.29.0",
      "protobufjs": "7.6.5",
      "ws": "7.5.11",
      "serialize-javascript": "7.0.5",
      "webpack-dev-server": "5.2.6",
      "@opentelemetry/core": "2.8.0",
      "dompurify": "3.4.12",
      "http-proxy-middleware": "2.0.10",
      "joi": "17.13.4",
      "qs": "6.15.2",
      "postcss": "8.5.23",
      "sockjs>uuid": "11.1.1",
      "body-parser": "1.20.6",
      "@babel/core": "7.29.6"
    }
  },
  "scripts": {
    "build": "docusaurus build",
    "dev": "docusaurus start --port 3001",
    "format": "prettier --write 'docs/**/*.{md,mdx}' '*.{ts,tsx,json}' 'src/**/*.{ts,tsx,css}' 'sidebars.ts' 'docusaurus.config.ts'",
    "lint": "prettier --check 'docs/**/*.{md,mdx}' '*.{ts,tsx,json}' 'src/**/*.{ts,tsx,css}' 'sidebars.ts' 'docusaurus.config.ts'",
    "start": "docusaurus serve",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
