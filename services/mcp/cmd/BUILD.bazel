load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/recurser/bossanova-mcp/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/bossalib/contract/daemon/socketauth",
        "//lib/bossalib/kit/bossmcp",
        "//lib/bossalib/kit/buildinfo",
        "//services/mcp/api/serve",
        "//services/mcp/internal/adapter/socketbackend",
    ],
)

go_binary(
    name = "cmd",
    embed = [":cmd_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "cmd_test",
    srcs = [
        "main_test.go",
        "run_test.go",
    ],
    embed = [":cmd_lib"],
    deps = ["//lib/bossalib/contract/daemon/socketauth"],
)
