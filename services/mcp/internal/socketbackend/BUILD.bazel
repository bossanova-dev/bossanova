load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "socketbackend",
    srcs = ["socketbackend.go"],
    importpath = "github.com/recurser/bossanova-mcp/internal/socketbackend",
    visibility = ["//services/mcp:__subpackages__"],
    deps = [
        "//lib/bossalib/bossmcp",
        "//lib/bossalib/config",
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/gen/bossanova/v1/bossanovav1connect",
        "@com_connectrpc_connect//:connect",
    ],
)

go_test(
    name = "socketbackend_test",
    srcs = ["socketbackend_test.go"],
    embed = [":socketbackend"],
    deps = [
        "//lib/bossalib/gen/bossanova/v1:bossanova",
        "//lib/bossalib/gen/bossanova/v1/bossanovav1connect",
        "@com_connectrpc_connect//:connect",
    ],
)
