    {
      "message": "feat(api): mark overdue invoices",
      "files": {
        "services/api/schema/invoice.graphqls": [
          "scalar Date",
          "",
          "type Invoice {",
          "  id: ID!",
          "  number: String!",
          "  totalCents: Int!",
          "  status: InvoiceStatus!",
          "  dueOn: Date",
          "}",
          "",
          "enum InvoiceStatus {",
          "  DRAFT",
          "  SENT",
          "  PAID",
          "  OVERDUE",
          "}",
          "",
          "type Query {",
          "  invoice(id: ID!): Invoice",
          "}",
          "",
          "type Mutation {",
          "  markOverdue(asOf: Date!): Int!",
          "}"
        ],
        "services/api/service/invoice_overdue.go": [
          "package service",
          "",
          "import \"time\"",
          "",
          "// MarkOverdue moves every sent invoice whose due date has passed to OVERDUE and returns how many",
          "// it moved.",
          "func MarkOverdue(invoices []*Invoice, asOf time.Time) int {",
          "\tmoved := 0",
          "\tfor _, invoice := range invoices {",
          "\t\tif invoice.Status != \"SENT\" || invoice.DueOn == nil {",
          "\t\t\tcontinue",
          "\t\t}",
          "\t\tif invoice.DueOn.Before(asOf) {",
          "\t\t\tinvoice.Status = \"OVERDUE\"",
          "\t\t\tmoved++",
          "\t\t}",
          "\t}",
          "\treturn moved",
          "}"
        ],
        "services/api/service/invoice_overdue_test.go": [
          "package service",
          "",
          "import (",
          "\t\"testing\"",
          "\t\"time\"",
          ")",
          "",
          "func TestMarkOverdueMovesOnlyPastDueSentInvoices(t *testing.T) {",
          "\tasOf := time.Date(2026, 3, 1, 0, 0, 0, 0, time.UTC)",
          "\tpast := asOf.AddDate(0, 0, -1)",
          "\tinvoices := []*Invoice{",
          "\t\t{Status: \"SENT\", DueOn: &past},",
          "\t\t{Status: \"PAID\", DueOn: &past},",
          "\t\t{Status: \"SENT\"},",
          "\t}",
          "\tif moved := MarkOverdue(invoices, asOf); moved != 1 {",
          "\t\tt.Fatalf(\"moved %d invoices, want 1\", moved)",
          "\t}",
          "}"
        ]
      }
    }
