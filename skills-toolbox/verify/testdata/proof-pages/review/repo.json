      "message": "feat: expire sessions after a day and drop legacy tokens",
      "files": {
        "src/auth/session.ts": [
          "import { store } from './store'",
          "",
          "export const SESSION_TTL_MS = 24 * 60 * 60 * 1000",
          "",
          "export type Session = { id: string; userId: string; createdAt: number }",
          "",
          "export function readSession(id: string, now = Date.now()): Session | null {",
          "  const session = store.get(id)",
          "  if (!session) return null",
          "  if (now - session.createdAt > SESSION_TTL_MS) {",
          "    store.delete(id)",
          "    return null",
          "  }",
          "  return session",
          "}",
          "",
          "export function dropSession(id: string): void {",
          "  store.delete(id)",
          "}"
        ],
        "src/auth/session.test.ts": [
          "import { test } from 'node:test'",
          "import assert from 'node:assert/strict'",
          "import { readSession, SESSION_TTL_MS } from './session'",
          "import { store } from './store'",
          "",
          "test('an expired session reads as none and is dropped', () => {",
          "  store.set('s1', { id: 's1', userId: 'u1', createdAt: 0 })",
          "  assert.equal(readSession('s1', SESSION_TTL_MS + 1), null)",
          "  assert.equal(store.has('s1'), false)",
          "})"
        ],
        "src/auth/legacy-token.ts": null
      }
    }
  ]
