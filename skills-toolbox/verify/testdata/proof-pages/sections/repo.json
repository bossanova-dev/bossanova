      "message": "feat(api): send texts from a dedicated sender number",
      "files": {
        "api/sms.go": [
          "package api",
          "",
          "import \"errors\"",
          "",
          "// ErrNoSender says a text cannot go out because no sender number is set.",
          "var ErrNoSender = errors.New(\"no sender number\")",
          "",
          "// Sender is the number texts come from, refused when it is not set.",
          "func Sender(env map[string]string) (string, error) {",
          "\tfrom := env[\"SMS_SENDER_NUMBER\"]",
          "\tif from == \"\" {",
          "\t\treturn \"\", ErrNoSender",
          "\t}",
          "\treturn from, nil",
          "}"
        ],
        "db/migrations/002_sender_brand.sql": [
          "ALTER TABLE outgoing_messages",
          "  ADD COLUMN sms_sender_brand text NOT NULL DEFAULT 'acme';"
        ],
        "deploy/overlays/production/config.yaml": [
          "apiVersion: v1",
          "kind: ConfigMap",
          "metadata:",
          "  name: api-config",
          "data:",
          "  LOG_LEVEL: info",
          "  SMS_SENDER_NUMBER: \"+61 400 000 000\""
